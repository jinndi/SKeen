local ip_data ln_data mt_data tf_data v6_flags
printf "$W%-10s %-4s %-5s %-6s %-10s %-10s$N\n" "INTERFACE" "IPv6" "MTU" "LINK" "RX/TX (MB)" "IP ADDRESS"
