if command -v conntrack >/dev/null 2>&1;then
cw="$(conntrack -S 2>/dev/null|awk '
      { for(i=1;i<=NF;i++) { split($i,p,"="); if(p[1]!="cpu" && p[2]~/^[0-9]+$/) total[p[1]]+=p[2] } }
      END { for(key in total) print key,total[key] }
    '|sort -k1,1)"
if [ -n "$cw" ];then
printf '%s\n' "$cw"|awk '
        BEGIN { print "Счётчик|Кол-во|Пояснение" }
        $1=="insert_failed" {
          m="Не удалось добавить запись; проверьте, растёт ли"
          m=m "" }
        $1=="early_drop" { m="Записи удалялись раньше срока; проверьте рост" }
        $1=="drop" { m="Пакеты отброшены conntrack; проверьте рост" }
        $1=="invalid" {
          m="Пакеты помечены INVALID; часто это обычный сетевой шум"
          m=m "" }
        $1=="error" { m="Ошибки обработки; счётчик накопительный" }
        $1=="ignore" { m="Пакеты намеренно не отслеживались; часто это нормально" }
        $1=="found" { m="Найдена существующая запись; информационный счётчик" }
        $1=="insert" { m="Добавлены новые записи; информационный счётчик" }
        $1=="search_restart" {
          m="Перезапуск поиска; обычно информативно"
          m=m "" }
        m!="" { print $1 "|" $2 "|" m; m="" }
      '|AG
else
V "Данные счётчиков недоступны"
fi
else
V "Счётчики недоступны без утилиты conntrack"
fi
printf '\n'
Aw "--- Локальные TCP-сокеты (netstat) ---"
echo "netstat показывает сокеты роутера; conntrack учитывает трафик клиентов."
if ! command -v netstat >/dev/null 2>&1;then
V "netstat не установлен"
else
ev="$(netstat -antp 2>/dev/null|awk '
      $1~/^tcp/ && $6!="" { count[$6]++ }
      END { for(s in count) printf "%s|%s\n",s,count[s] }
    ')"
if [ -z "$ev" ];then
V "Данные TCP-сокетов недоступны"
else
printf '%s\n' "$ev"|sort -t'|' -k1,1|awk -F'|' '
        BEGIN { print "Состояние TCP|Кол-во|Пояснение" }
        { s=$1; m=s
          if(s=="ESTABLISHED") m="Соединение активно"; else if(s=="SYN_SENT") m="Ожидается ответ удалённой стороны"
          else if(s=="SYN_RECV") m="Ожидается завершение TCP handshake"
          else if(s=="FIN_WAIT1" || s=="FIN_WAIT2") m="Соединение закрывается"
          else if(s=="CLOSE_WAIT") { m="Удалённая сторона закрыла; приложение ещё не закрыло сокет"; m=m "" }
          else if(s=="LAST_ACK") m="Ожидается подтверждение закрытия"
          else if(s=="TIME_WAIT") m="Недавно закрыто; запись истечёт сама"
          else if(s=="LISTEN") m="Ожидание входящих подключений"
          printf "%s|%s|%s\n",s,$2,m }'|AG
fi
fi
printf '\n'
Aw "--- Метки соединений ---"
if [ -n "$ei" ];then
printf '%s\n' "$ei"|awk -F'|' '
      BEGIN { print "Метка (dec / hex)|Кол-во|Пояснение" }
      { mark=$1; value=mark; count=$2
        if(mark=="unmarked") { value="нет"; d="conntrack не видит метку" }
        else {
          if(mark~/^[0-9]+$/) value=mark " / " sprintf("0x%x",mark+0)
          if(mark=="0" || mark=="0x0") d="Метка не установлена"
          else if(mark=="18" || mark=="0x12") d="SKeen: метка TProxy/policy routing (0x12)"
          else d="Другая метка; источник неизвестен по значению" }
        printf "%s|%s|%s\n",value,count,d }
    '|AG
else
echo "Соединения с меткой не найдены"
fi
}
