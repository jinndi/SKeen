[ -z "$line" ]&&continue
case "$line" in
\#*)continue
esac
hl=$(echo "$line"|cut -d ' ' -f1)
dr="$dr $hl"
done <<EOF
$co
EOF
bv=""
for addr in $em;do
[ -z "$addr" ]&&continue
[ "${addr#*/}" = "$addr" ]&&addr="$addr/$bo"
case "$gu" in
4)fq=is_valid_ipv4;;
6)fq=is_valid_ipv6
esac
if $fq "$addr";then
dr="$dr $addr"
else
bv="$bv $addr"
fi
done
[ -n "$bv" ]&&{
BP&&V "Неверные IPv$gu исключения: $bv"
BT "Неверные IPv$gu исключения: $bv"
