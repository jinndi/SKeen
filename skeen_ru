is_valid_ipv4(){
local addr="${1:-}"
local ip hb o1 o2 o3 o4 o
ip="${addr%%/*}"
hb="${addr#*/}"
IFS=. read -r o1 o2 o3 o4 <<EOF
$ip
EOF
[ "$o1" ]&&[ "$o2" ]&&[ "$o3" ]&&[ "$o4" ]||return 1
for o in $o1 $o2 $o3 $o4;do
[ "$o" -ge 0 ] 2>/dev/null||return 1
[ "$o" -le 255 ] 2>/dev/null||return 1
done
if [ "$ip" != "$addr" ];then
case "$hb" in ''|[0-9]|[1-2][0-9]|3[0-2]);;*)return 1;esac
fi
}
is_valid_ipv6(){
local addr="${1:-}"
local gm hb
gm="${addr%%/*}"
hb="${addr#*/}"
ip -6 route get "$gm" >/dev/null 2>&1||return 1
if [ "$gm" != "$addr" ];then
case "$hb" in
''|[0-9]|[1-9][0-9]|1[0-2][0-8]);;
*)return 1
esac
fi
}
Bc(){
local label="${1:-}"
local hi="${2:-}"
local bq bc start gs p
hi=$(printf '%s' "$hi"|tr ',\r' '  ')
for p in $hi;do
[ -z "$p" ]&&continue
case "$p" in
*-*)start="${p%-*}"
gs="${p#*-}"
;;
*:*)start="${p%:*}"
gs="${p#*:}"
;;
*)start="$p"
gs="$p"
esac
start=$(printf '%s' "$start"|tr -cd '0-9')
gs=$(printf '%s' "$gs"|tr -cd '0-9')
if [ -z "$start" ]||[ -z "$gs" ];then
bc="${bc:+$bc }$p"
continue
fi
if [ "$start" -lt 1 ]||[ "$gs" -gt 65535 ]||[ "$start" -gt "$gs" ];then
bc="${bc:+$bc }$p"
else
if [ "$start" -eq "$gs" ];then
bq="${bq:+$bq }$start"
else
bq="${bq:+$bq }$start-$gs"
fi
fi
done
if [ -n "$bc" ];then
local msg="Неверные $label порт(ы): $bc"
BT "$msg"
BP&&V "$msg" >&2
fi
printf '%s' "$bq"
}
BG(){
local version="${1:-}"
local fe="32"
[ "$version" = "6" ]&&fe="128"
local interfaces
interfaces=$(ip -"$version" route show table all 2>/dev/null|awk '/default/ {for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}'|sort -u)
[ -z "$interfaces" ]&&return 0
local result
result=$(echo "$interfaces"|while read -r dev;do
[ -z "$dev" ]&&continue
ip -"$version" addr show "$dev" scope global 2>/dev/null|awk -v pref="$fe" '/inet/ {split($2,a,"/"); print a[1] "/" pref}'
done|sort -u|tr '\n' ' ')
echo "$result"|xargs
}
BO(){
