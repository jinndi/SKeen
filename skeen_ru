elif [ "$er" -ge 950 ];then
Bq "Оценка: КРИТИЧНО — таблица conntrack почти заполнена"
elif [ "$er" -ge 800 ];then
Bv "Оценка: ВНИМАНИЕ — таблица заполнена более чем на 80%"
