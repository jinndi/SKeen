[ -n "$cc" ]&&{
local has_p=0
[ -n "$ext_ui" ]&&has_p=1
CR "clash_api" "$(fa "${cc%%:*}" "${cc##*:}")" "$has_p" "Clash" "$sb_run"
}
if [ "$json" -eq 1 ];then printf "%s]\n" "$o";else printf "%b\n" "$panels\n$apis"|sed '/^$/d';fi
}
Ak(){
local src_file="${1:-}"
local target_dir="${2:-}"
mkdir -p "$target_dir"
local KEYS=""
eval "$(jsonfilter -i "$src_file" -e 'KEYS=@')"
local schema_val=""
schema_val="$(jsonfilter -i "$src_file" -e "@['\$schema']")"
local schema_prefix=""
if [ -n "$schema_val" ];then
schema_val="$(echo "$schema_val"|sed 's#\\/#/#g')"
schema_prefix="$(printf '  "$schema": "%s",\n' "$schema_val")"
fi
for key in $KEYS;do
case "$key" in
\$*)continue
esac
local val
val=$(jsonfilter -i "$src_file" -e "@['$key']")
if [ -n "$val" ];then
val=$(echo "$val"|sed 's#\\/#/#g')
printf '{\n%s  "%s": %s\n}\n' "$schema_prefix" "$key" "$val" >"$target_dir/$key.json"
fi
done
}
CJ(){
local address="${1:-}" az
get_singbox_config
if [ -z "$address" ];then
[ -z "$SINGBOX_CONFIG_URL" ]&&O "Адрес для синхронизации не указан"&&return 1
address="$SINGBOX_CONFIG_URL"
fi
if ! echo "$address"|grep -qE '^https?://';then
O "URL должен начинаться с http:// или https://"
return 1
fi
az="$(mktemp /tmp/skeen_sync.XXXXXX)"||{
O "Не удалось создать временный файл"
return 1
}
if ! Ab -s --max-time 20 "$address" -o "$az";then
rm -f "$az"
O "Не удалось загрузить конфигурацию с $address"
return 1
fi
if ! $SINGBOX_BIN check -c "$az";then
rm -f "$az"
O "$h конфигурация c ошибками, синхронизация отменена!"
return 1
fi
if [ -n "$SINGBOX_CONFIG_DIR" ];then
local tmp_target_dir
tmp_target_dir="$(mktemp -d /tmp/skeen_dir.XXXXXX)"||{
rm -f "$az"
O "Не удалось создать временную директорию"
return 1
}
if [ "$SINGBOX_CONFIG_SPLIT" = "1" ];then
if ! Ak "$az" "$tmp_target_dir";then
rm -rf "$tmp_target_dir"
rm -f "$az"
O "Ошибка при разделении конфигурации, синхронизация отменена!"
return 1
fi
else
mv -f "$az" "$tmp_target_dir/config.json"
fi
local backup_dir="${SINGBOX_CONFIG_DIR}_backup"
rm -rf "$backup_dir"
cp -a "$SINGBOX_CONFIG_DIR" "$backup_dir" 2>/dev/null
rm -rf "${SINGBOX_CONFIG_DIR:?}"
mv -f "$tmp_target_dir" "$SINGBOX_CONFIG_DIR"
elif [ -f "$SINGBOX_CONFIG" ];then
cp -f "$SINGBOX_CONFIG" "$SINGBOX_CONFIG.bak"
if ! mv -f "$az" "$SINGBOX_CONFIG";then
mv -f "$SINGBOX_CONFIG.bak" "$SINGBOX_CONFIG"
O "Не удалось сохранить файл конфигурации, выполнен откат!"
return 1
fi
else
mv -f "$az" "$SINGBOX_CONFIG"
fi
rm -f "$az"
U "Конфигурация синхронизирована, перезапустите $aa для применения изменений"
return 0
}
CF(){
local hwid line hp os ver ht json
AK
hwid="$(tr '[:lower:]' '[:upper:]' </proc/sys/kernel/random/uuid)"
line="$(printf '%s\n' \
"Windows|10.0.19045,Windows 10|10.0.22631,Windows 11|10.0.26100,Windows 11 24H2|10.0.19042,Windows 10 20H2" \
"Linux|5.15.0-88,Ubuntu 22.04 LTS|6.8.0-45,Ubuntu 24.04 LTS|6.1.0-21,Debian 12|6.9.7,Arch Linux|6.6.2,Manjaro" \
"macOS|14.5.0,MacBook Pro|14.6.0,MacBook Air|15.0.0,Mac mini|13.6.7,MacBook Pro M1"|awk 'BEGIN{srand()} {a[NR]=$0} END{print a[int(rand()*NR)+1]}')"
hp="$(printf '%s' "${line#*|}"|tr '|' '\n'|awk 'BEGIN{srand()} {a[NR]=$0} END{print a[int(rand()*NR)+1]}')"
os="${line%%|*}"
