Af(){
local ee=""
local eh="Прокси-сервис включен, но"
AV
if [ -n "$SERVICE_PROXY_ENABLED" ]&&[ "$SERVICE_PROXY_ENABLED" = "1" ];then
if [ -z "$SERVICE_PROXY_PORT" ];then
O "$eh 'service_proxy.port' не задан"&&return 1
elif ! AB;then
O "$eh $h не запущен"&&return 1
elif ! netstat -tuln 2>/dev/null|grep -q ":$SERVICE_PROXY_PORT";then
O "$eh процесс не слушает на порту $SERVICE_PROXY_PORT"&&return 1
else
ee="--socks5-hostname 127.0.0.1:$SERVICE_PROXY_PORT"
