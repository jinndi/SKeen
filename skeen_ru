          else if(s=="FIN_WAIT1" || s=="FIN_WAIT2") m="Соединение закрывается"
          else if(s=="CLOSE_WAIT") { m="Удалённая сторона закрыла; приложение ещё не закрыло сокет"; m=m "" }
          else if(s=="LAST_ACK") m="Ожидается подтверждение закрытия"
          else if(s=="TIME_WAIT") m="Недавно закрыто; запись истечёт сама"
          else if(s=="LISTEN") m="Ожидание входящих подключений"
          printf "%s|%s|%s\n",s,m,$2 }'|AG
P "Итог: проверяйте долго открытые сокеты и рост их числа."
fi
fi
printf '\n'
As "--- Метки соединений ---"
if [ -n "$eg" ];then
printf '%s\n' "$eg"|awk -F'|' '
      BEGIN { print "Метка (dec / hex)|Кол-во|Назначение" }
