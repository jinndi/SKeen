o="$o{\"type\":\"$type\",\"url\":\"http://$addr\"}"
fst=0
else
local label
label="$(AD "$hf API$([ "$has_p" -eq 1 ]&&echo "+UI")$([ "$go" -eq 0 ]&&Bn " (off)")")"
[ "$has_p" -eq 1 ]&&panels="$panels\n$label: http://$addr"||apis="$apis\n$label: http://$addr"
fi
}
[ "$json" -eq 0 ]&&{
AJ 2>/dev/null
