Az "$sing_config_use_dir" "$eg" "$dc"
export BOX_API_URL="$sing_api_url"
export BOX_API_SECRET="$sing_api_secret"
fi
if [ "$mode" = "--json" ]&&[ -z "$SINGBOX_CONFIG_DIR" ];then
printf '{"path":"%s","is_dir":%s}\n' "$SINGBOX_CONFIG" "false"
return 0
fi
if [ -n "$SINGBOX_CONFIG_DIR" ];then
if [ "$mode" = "--json" ];then
printf '{"path":"%s","is_dir":%s}\n' "$SINGBOX_CONFIG_DIR" "true"
return 0
fi
if [ ! -f "$SINGBOX_CONFIG" ]||[ -n "$(find "$SINGBOX_CONFIG_DIR" -mindepth 1 -newer "$SINGBOX_CONFIG" -print -quit)" ];then
if ! "$SINGBOX_BIN" merge "$SINGBOX_CONFIG" -C "$SINGBOX_CONFIG_DIR" >/dev/null 2>&1;then
O "Ошибка слияния конфига $h из $SINGBOX_CONFIG_DIR"
fi
fi
fi
Ag
}
