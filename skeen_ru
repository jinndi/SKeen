local use_dir="${1:-0}" bz="${2:-}" by="${3:-}" src
if [ "$use_dir" = "1" ];then
mkdir -p "$bz"
if [ -z "$(ls -A "$bz")" ];then
if [ -f "$by" ]&&[ "$SINGBOX_CONFIG_SPLIT" = "1" ];then
An "$by" "$bz"||echo '{}' >"$bz/config.json"
