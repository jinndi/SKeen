if jsonfilter -i "$(V)" -e '@.auto_start' >/dev/null;then
U "$aa JSON корректен"
else
local err_msg="$aa конфигурация не корректна"
O "$err_msg"
h "$err_msg"
fi
}
BS(){
if get_singbox_config&&[ -f "$SINGBOX_BIN" ];then
P "Проверка конфигурации $h..."
local config="-c $SINGBOX_CONFIG"
[ -n "$SINGBOX_CONFIG_DIR" ]&&config="-C $SINGBOX_CONFIG_DIR"
if $SINGBOX_BIN check $config;then
U "Конфигурация $h корректна"
else
local err_msg="$h конфигурация не корректна"
h "$err_msg"
if [ "$CALLER" != "init" ];then
O "$err_msg"
J 1
fi
fi
fi
}
BD(){
Ao
BS
}
Bt(){
if get_singbox_config&&[ -f "$SINGBOX_BIN" ];then
P "Форматирование конфигурации $h..."
local config="-c $SINGBOX_CONFIG"
[ -n "$SINGBOX_CONFIG_DIR" ]&&config="-C $SINGBOX_CONFIG_DIR"
if $SINGBOX_BIN format -w $config;then
U "Конфигурация отформатирована успешно"
else
O "Ошибка форматирования конфигурации"
fi
else
O "Исполняемый файл $h отсутствует"
fi
}
CS(){
local gk="Поддерживается только в $h 1.14.0+"
shift
AK
get_singbox_config
if [ -f "$SINGBOX_BIN" ];then
local version major minor
version="$(AA "sing")"
major="${version%%.*}"
minor="${version#1.}"
minor="${minor%%.*}"
if [ "$major" -eq 1 ]&&[ "$minor" -eq 14 ];then
case "$version" in
*alpha*|*beta*)AE "$gk"
esac
fi
if [ "${version%%.*}" -ge 1 ]&&[ "$minor" -ge 14 ];then
"$SINGBOX_BIN" api "$@"
else
AE "$gk"
fi
else
AE "Исполняемый файл $h отсутствует"
fi
}
Bu(){
get_singbox_config
local f="$SINGBOX_CONFIG" json=0 o="" fst=1
[ "${1:-}" = "--json" ]&&json=1
[ "$json" -eq 1 ]&&o="["
ip="$(ip -4 addr show dev br0 2>/dev/null|awk '/inet /{print $2}'|cut -d/ -f1)"
