mt_data="$(awk '{print FILENAME ":" $0}' /sys/class/net/*/mtu 2>/dev/null|sed 's|/sys/class/net/||;s|/mtu||')"
tf_data="$(cat /proc/net/dev|tail -n +3|tr ':' ' '|awk '{$1=$1;print}')"
