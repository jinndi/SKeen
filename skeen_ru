    pad = 10 - length(tr_p)
    for (p=0; p<pad; p++) printf " "
    printf " %s%s%s\n", y, (ip4[ifc] ? ip4[ifc] : "-"), n
    if (ip6[ifc]) {
      printf "                                        %s%s%s\n", b, ip6[ifc], n
    }
  }'
}
