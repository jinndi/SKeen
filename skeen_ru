output="$output\n  $(AL "3.") Обновление"
output="$output\n  $(AL "4.") Тестировать"
output="$output\n  $(AL "5.") Удаление"
output="$output\n  $(AL "0.") Выход\n"
Bl
printf '%b\n' "$output"
max_attempts=3
attempt=0
while [ $attempt -lt $max_attempts ];do
printf "Выбор [0-5]: " >/dev/tty
read -r option </dev/tty
printf "\n"
case "$option" in
[1-5])echo "$be"
case "$option" in
1)CC;;
