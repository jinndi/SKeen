*[!0-9:]*|:*|*:|*:0)V "Таблица conntrack: не удалось прочитать число записей/лимит";;
*)er="$(awk -v count="$ds" -v max="$gc" 'BEGIN { printf "%d", count * 1000 / max }')"
printf 'Таблица conntrack: %s / %s записей (заполнена на %s.%s%%)\n' \
