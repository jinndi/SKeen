}
local panels="" apis=""
CR(){
local type="$1" addr="$2" has_p="$3" hf="$4" go="${5:-1}"
[ -n "$addr" ]||return
if [ "$json" -eq 1 ];then
[ "$type" = "skeen_api" ]||[ "$has_p" -ne 1 ]||[ "$go" -eq 0 ]&&return
