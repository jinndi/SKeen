BP(){
[ "${FORCE_COLOR:-0}" = "1" ]||[ -t 1 ]||[ -t 2 ]
ret=$?
BP(){ return "$ret";}
return "$ret"
}
Bw(){
local hv="${1:-}" hs="${2:-}"
if BP;then printf '\033[%sm%s\033[0m\n' "$hv" "$hs";else printf '%s\n' "$hs";fi
}
AD(){ Bw 36 "$1";}
Aw(){ Bw '1;38;5;30' "$1";}
Bq(){ Bw 31 "$1";}
AL(){ Bw 32 "$1";}
Bv(){ Bw 33 "$1";}
P(){ AD "[INFO] $1";}
T(){ AL "[OK] $1";}
V(){ Bv "[WARN] $1";}
O(){ Bq "[ERROR] $1";}
AE(){
Bq "[FATAL] $1"
exit 1
}
AK(){ BP||{
O "Command supports only tty"
exit 1
};}
BQ(){ logger -p "$1" -t "$aa" "$2";}
AT(){ BQ notice "$1";}
BT(){ BQ warning "$1";}
h(){ BQ error "$1";}
AS(){
local type="${1:-unknown}" table="${2:-unknown}"
[ "$CALLER" = "netfilter" ]&&AT "Updating $type rules for $table table"||true
}
if BP;then
cleanup(){ { stty sane </dev/tty;} 2>/dev/null||true;}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'printf "\n"; exit 130' INT
fi
Aa(){ if [ ! -d "$ea" ];then mkdir -p "$ea"&&chmod 700 "$ea";fi;}
AR(){
if [ "$1" = "force" ];then
rm -f "$ao" "$as"
elif [ -f "$ao" ];then
P "Configuration file $aa already exists, skipping creation"
return
fi
P "Creating configuration file $aa..."
mkdir -p "$(dirname "$ao")"
cat <<EOF >"$ao"
// $fb
{
  "auto_start": {
    "enabled": 1
  },
  "policy": {
    "enabled": 0,
    "segment": "br1"
  },
  "network": {
    "ipv6": 1,
    "tuning": 0
  },
  "singbox": {
    "config": {
      "use_dir": 0,
      "url": "",
      "split": 1
    },
    "api": {
      "url": "http://127.0.0.1:9999",
      "secret": ""
    },
    "external": {
      "enabled": ${EXTERNAL_ENABLED:-0},
      "path": "",
      "config": {
        "use_dir": 0,
        "url": "",
        "split": 1
      },
      "api": {
        "url": "",
        "secret": ""
      }
    }
  },
  "services": {
    "api": {
      "auto_start": 1,
      "port": 3000,
      "secret": "",
      "cors_origin": ["*"],
      "dashboard": 1
    },
    "proxy": {
      "enabled": 0,
      "port": "",
      "user": "",
      "pass": ""
    }
  },
  "firewall": {
    "intercept": {
      "dns": 1,
      "fakeip": {
        "enabled": 0,
        "clients": []
      }
    },
    "exclude": {
      "port": ["137:139", 445, 500, 1900, 4500],
      "ipv4_cidr": [],
      "ipv6_cidr": []
    },
