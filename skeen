        $1=="ignore" { m="Packets intentionally not tracked; often normal" }
        $1=="found" { m="Existing entry found; informational" }
        $1=="insert" { m="New entries inserted; informational" }
        $1=="search_restart" {
          m="Hash search restarted; usually informational"
          m=m "" }
        m!="" { print $1 "|" $2 "|" m; m="" }
