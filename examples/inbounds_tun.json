// TUN OpkgTun KeeneticOS v5+
// NOT recommended, CPU usage is ~20% higher TProxy

// Create OpkgTun
// skeen tun create 172.18.0.1 "SKeenTUN"

// Delete OpkgTun
// skeen tun delete "SKeenTUN"


{
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "opkgtun0",
      "address": "172.18.0.1/30", // NOT use IP v6
      "auto_route": false,
      "mtu": 1500,                // IMPORTANT
      "udp_timeout": "3m",
      "stack": "system"           // NOT use gvisor !!!
    }
  ]
}
