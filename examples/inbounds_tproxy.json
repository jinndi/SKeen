// TProxy only mode (TCP & UDP) HTTPS port 443 must be freed in the router (Users and Access section)
// DNS interception at early stage (firewall.intercept.dns)
// or through redirection (firewall.redirect_dns in config, see inbounds_dns-redirect.json)

// Только TProxy режим (TCP и UDP) требует освобождения 443 HTTPS порта в роутере (Пользователи и доступ)
// DNS перехват на ранней стадии (firewall.intercept.dns)
// или через редирект (firewall.redirect_dns в skeen.json конфигурации, см. inbounds_dns-redirect.json)

{
  "inbounds": [
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "::",
      "listen_port": 65082,
      "tcp_fast_open": true,
      "udp_fragment": true,
      "udp_timeout": "3m0s"
    }
  ]
}
