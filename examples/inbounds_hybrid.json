// Hybrid mode (TCP Redirect + UDP TProxy)
// DNS interception at early stage (firewall.intercept.dns)
// or through redirection (firewall.redirect_dns in config, see inbounds_dns-redirect.json)

// Гибридный режим (TCP Redirect + UDP TProxy)
// DNS перехват на ранней стадии (firewall.intercept.dns)
// или через редирект (firewall.redirect_dns в skeen.json конфигурации, см. inbounds_dns-redirect.json)

{
  "inbounds": [
    {
      "type": "redirect",
      "tag": "redirect-in",
      "listen": "::",
      "listen_port": 65081,
      "tcp_fast_open": true
    },
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "::",
      "listen_port": 65082,
      "udp_timeout": "3m0s",
      "udp_fragment": true,
      "network": "udp"
    }
  ]
}
