//// Конфигурация для шаблонов по умолчанию при выходе версии sing-box 1.14
//// С комментариями, заточенная специально для России и всех типов операторов связи.

// 0. Чебурнет здесь.

// 1. Пожалуйста, скорректируйте шаблон в соответствии с вашей ситуацией.
// Лучший шаблон - тот, который вам больше всего подходит.
// Если у вас нет особых требований, вы можете скопировать всё дословно.

// 2. Это решение обеспечивает маршрутизацию RU-трафика через селектор "🇷🇺 Россия" отдельно от Чебурнета,
// обход российских IP-адресов, а также неизвестных доменов, если их IP географически находятся в РФ.
// Дополнительно предотвращаются утечки DNS и IP-адресов серверов подключения.

// 3. Рекомендуется установить параметр `client_subnet` в диапазон IP-адресов DNS-сервера по умолчанию,
// назначенного вашим текущим провайдером широкополосного доступа
// (это можно проверить на странице вашего роутера, или обратившись к общедоступному каталогу DNS).
// Например, если DNS-сервер по умолчанию - 77.88.8.8, вы можете установить его на 77.88.8.0/24.

// 4. Для работы селектора «🏴‍☠️ Торрент» убедитесь, что в торрент-клиенте для подключения к пирам выбран протокол «только TCP»
// и в настройках приватности не установлено принудительное шифрование.
// Скорость при прямом подключении создаёт нагрузку на процессор, сопоставимую с работой без маршрутизации трафика через sing-box.
// При этом решение сохраняет работоспособность в любых окружениях.

// 5. Узел GLOBAL использует селектор выбора узлов ("🌍 Выбор узла") в качестве обходного маршрута для загрузки rule_set,
// zashboard и обработки DNS-запросов проксируемого трафика.
// !!! ВАЖНО: в селекторе "🌍 Выбор узла" необходим рабочий узел по умолчанию как минимум для первого старта sing-box,
// для этого укажите его тег в параметре "default".

// 6. Заполнять узлы и синхронизировать сам конфиг через "skeen sync" можно, настроив Sub-Store (смотрите файл Sub-Store-sync-cheburnet.md)

{
  // ══════════════════════════════════════════════
  // Настройка логирования
  // ══════════════════════════════════════════════
  // Измените на fatal, чтобы видеть только фатальные ошибки, не для обычного логирования.
  // level="debug": чтобы увидеть полную цепочку логов во время отладки.
  // timestamp=true: Каждая запись в логе имеет метку времени, что упрощает отслеживание хронологии проблем.
  // Почему не использовать debug: Производительность роутеров ограничена, отладочные логи огромны (десятки в секунду),
  // fatal достаточно для повседневного использования.

  "log": { "disabled": false, "level": "debug", "output": "", "timestamp": false },

  // ══════════════════════════════════════════════
  // Конфигурация DNS - ядро ​​всей архитектуры,
  // определяющее разделение внутреннего и международного трафика
  // ══════════════════════════════════════════════
  "dns": {
    "servers": [
      // DNS-сервер 1: Файл hosts жестко закодирован локально ──
      // Назначение: Предварительная запись IP-адреса самого DNS-сервера во избежание бесконечного цикла "Разрешение DNS-сервера требует DNS-сервера"
      // Зачем это нужно: dns_direct необходимо подключиться к common.dot.dns.yandex.net, но common.dot.dns.yandex.net сам требует разрешения DNS
      // Файл hosts напрямую сообщает sing-box IP-адрес common.dot.dns.yandex.net, устраняя необходимость в отдельном поиске.
      {
        "tag": "hosts", "type": "hosts",
        "predefined": {
          "one.one.one.one": [ "1.1.1.1", "1.0.0.1", "2606:4700:4700::1111", "2606:4700:4700::1001" ],
          "common.dot.dns.yandex.net": [ "77.88.8.8", "77.88.8.1", "2a02:6b8::feed:0ff", "2a02:6b8:0:1::feed:0ff" ],
          "my.netcraze.pro": [ "192.168.1.1" ]
        }
      },

      // DNS-сервер 2: Локальный роутера
      // Используем его для разрешения приватных доменов
      { "tag": "dns_local", "type": "local" },

      // DNS-сервер 3: Yandex DNS-over-HTTPS
      // Примечание: публичный DNS-сервер Yandex использует протокол HTTPS (порт 443) для зашифрованной передачи.
      // Почему используется HTTPS вместо обычного UDP 53?
      // Интернет-провайдеры внутри страны могут перехватывать DNS-запросы UDP 53, возвращая некорректные IP-адреса.
      // HTTPS использует порт 443 и зашифрован, поэтому его невозможно перехватить интернет-провайдерами.
      // Почему стоит использовать Yandex DNS: Единсвенный DNS сервер который будет/уже жив внутри страны.
      { "tag": "dns_direct", "type": "https", "server": "common.dot.dns.yandex.net", "domain_resolver": "hosts" },

      // DNS-сервер 4: Cloudflare DNS-over-HTTPS (альтернативный, используется редко)
      // Примечание: В крайних случаях для разрешения доменов используется прокси-сервер для подключения к DNS Cloudflare.
      { "tag": "dns_proxy", "type": "https", "server": "one.one.one.one", "domain_resolver": "hosts", "detour": "GLOBAL"},

      // DNS-сервер 5: FakeIP (для международного трафика)
      // Примечание: Вместо реального IP-адреса будет возвращен фиктивный IP-адрес (198.18.xx).
      // Зачем использовать FakeIP:
      // 1. Предотвращение утечек DNS: Иностранные доменные имена не используют вышестоящие DNS-серверы.
      // 2. Точная маршрутизация: трафик с использованием поддельных IP-адресов неизбежно будет проходить через прокси, предотвращая ложные срабатывания.
      // 3. Производительность: IP-адреса генерируются локально без поиска в сети.
      // Что такое 198.18.0.0/15: это тестовый сегмент сети, зарезервированный IANA; этот IP-адрес не существует в общедоступном интернете.
      // Что такое fc00::/18: уникальный локальный адрес IPv6, эквивалентный частному адресу в IPv6.
      { "tag": "dns_fakeip", "type": "fakeip", "inet4_range": "198.18.0.0/15", "inet6_range": "fc00::/18" }
    ],

    // Правила DNS: Доменное имя → Сопоставление DNS-серверов
    // Порядок очень важен! Сравнивайте сверху вниз, останавливается, когда найдено совпадение.
    "rules": [
      // Правило 1: Используем host в маршрутизации hosts DNS сервер
      { "preferred_by": [ "hosts" ], "server": "hosts" },

      // Правило 2: Отклоняем домены сервисов проверки гео-IP.
      // Полностью запрещает запросы к детекторам IP-адресов. Это немного гарантирует, что
      // ни ваш реальный IP-адрес, ни IP-адрес прокси-сервера не будут раскрыты
      // встроенными антифрод-системами внутри зловредных приложений.
      // ! 2ip.ru, 2ip.io и т.п. не откроются, это необходимая мера!
      { "rule_set": [ "ip_geo_detect"], "action": "reject" },

      // Правило 3: В режиме Clash Direct используем только dns_direct → Yandex DNS
      { "clash_mode": "Direct", "server": "dns_direct" },

      // Правило 4: Приватные (локальные) DNS запросы обрабатываем DNS роутера
      { "rule_set": [ "private" ], "server": "dns_local" },

      // Правило 5: Набор правил фильтрации → Yandex DNS
      // Примечание: файл fakeip-filter.srs содержит список доменов, которые необходимо обходить с помощью поддельных IP-адресов.
      // Почему необходим обход: Некоторые домены, использующие поддельные IP-адреса, могут вызывать ошибки.
      { "rule_set": [ "fakeip_filter" ], "server": "dns_direct" },

      // Правило 6: Для RU доменов белого списка -> разолвим через Yandex DNS
      { "rule_set": [ "cheburnet" ], "server": "dns_direct" },

      // Правило 7: Защита от утечек: Блокировка запросов SVCB/HTTPS/PTR
      // SVCB/HTTPS: информация о соединении HTTP/3, может содержать реальные подсказки IP-адреса (ipv4hint/ipv6hint)
      // Если клиент получает реальный IP-адрес, он обходит подмену IP-адреса на поддельный.
      // PTR: Обратный поиск DNS (IP → доменное имя), не требуется для обычного использования.
      // После отклонения: клиент получает ответ об отклонении → автоматически повторяет поиск A (IPv4) / AAAA (IPv6).
      // Почему он расположен седьмым, а не первым в списке?
      // - В первых пяти правилах были разрешены внутренние домены, поэтому отклонение SVCB не влияет на них.
      { "query_type": [ "SVCB", "HTTPS", "PTR" ], "action": "reject" },

      // Правило 8: Защита от перегрузки таблицы Fake-IP торрент-трекерами.
      // Утилиты проверки IP получали реальные адреса, а не 198.18.x.x.
      { "rule_set": [ "trackerslist" ], "server": "dns_direct" },

      // Правило 9: Для проксируемых доменов назначаем Fake-IP
      { "rule_set": [ "games", "ai", "proxy"], "query_type": [ "A", "AAAA" ], "server": "dns_fakeip" },

      // Правило 10: Предопределенный DNS-ответ для блокировки рекламы.
      // По умолчанию sing-box ответит кодом NOERROR (запрос успешен), но не выдаст IP.
      // Это самый мягкий способ блокировки: приложения/сайты не зависают и не спамят повторными запросами.
      { "rule_set": [ "adguard" ], "action": "predefined" },

      // Правило 11: Для категории RU доменов разолвим через Yandex DNS
      { "rule_set": [ "ru" ], "server": "dns_direct" },

      // Правило 12: Для доменов, которые не прошли по праавилам выше -> делаем резолв через прокси Cloudflare DNS
      { "action": "evaluate", "server": "dns_proxy", "client_subnet": "77.88.8.0/24" },

      // Правило 13: Из передыдущего ответа ищем российские айпи в блоке -> назначаем Fake-IP
      { "match_response": true, "query_type": [ "A", "AAAA" ], "rule_set": [ "ru_ip_blocked" ], "server": "dns_fakeip" },

      // Правило 14: Ищем российские айпи (не в блоке) и отдаем результат в маршрутизацию
      { "match_response": true, "rule_set": [ "ru_ip" ], "action": "respond" },

      // Правило 15: Для зарубежных айпи (доменов) -> назначаем Fake-IP
      { "query_type": [ "A", "AAAA" ], "server": "dns_fakeip" },

      // Правило 16: Для глобального режима Clash используем прокси Cloudflare DNS после всех правил
      // для принудительного их использования в этом режиме
      { "clash_mode": "Global", "server": "dns_proxy" }
    ],

    // Глобальные настройки DNS
    "final": "dns_proxy",      // DNS в крайнем случае (в настоящее время заблокирован правилом 15, срабатывает редко)
    "strategy": "prefer_ipv4", // Политика DNS: Приоритет IPv4

    "timeout": "3s",           // Время ожидания DNS-запроса истекло через 3 секунды
    // Почему 3 секунды: Yandex DNS обычно возвращает результат дольше китайских аналогов на QUIC.
    // 3 секунды достаточно. Тайм-аут указывает на проблему с сетью. Быстрый сбой означает, что быстрая повторная попытка - лучший подход.

    "cache_capacity": 16384,  // Емкость DNS-кэша: 16384 записи
    // 16384 достаточно для охвата всех часто используемых доменов и экономии памяти.
    // Роутеры имеют 256МБ-1ГБ памяти, и эта запись занимает примерно 10-20 МБ.

    "optimistic": { "enabled": true, "timeout": "1h0m0s" }, // Оптимистическое кэширование DNS (срок истечения 1 час)
    // Принцип оптимистического кэширования:
    // 1. Если истекает срок действия DNS-записи (например, TTL=300 секунд), сначала верните старый результат (0 мс клиенту).
    // 2. Одновременно бэкэнд запрашивает новую информацию у Yandex DNS → незаметно обновляет кэш.
    // 3. Пользователи об этом не знают, и частота попаданий всегда равна 0 мс.
    // Почему 1 час: домены CDN видео меняются нечасто, и 1 часа достаточно.
    // Даже если кэш истечет через 1 час, будет выполнено повторное оптимистичное обновление.

    "reverse_mapping": true   // Включить обратное сопоставление DNS
    // Обратный поиск доменного имени по FakeIP (198.18.0.42 → youtube.com)
    // Ускорить сопоставление маршрутов и избежать дублирования перехвата трафика
  },

  // ═══════════════════════════════════════════════
  // HTTP-клиенты (используются для загрузки наборов правил)
  // ═══════════════════════════════════════════════
  "http_clients": [
    // HTTP-клиент GLOBAL (прокси через "🌍 Выбор узла")
    { "tag": "global_client", "version": 2, "detour": "GLOBAL", "stream_receive_window": 0, "connection_receive_window": 0 },
    // HTTP-клиент DIRECT (резервный)
    { "tag": "direct_client", "version": 2, "detour": "DIRECT", "stream_receive_window": 0, "connection_receive_window": 0 }
  ],

  // ══════════════════════════════════════════════
  // Конфигурация Inbounds - входящие подключения,
  // определяющее режим работы SKeen (способ "попадания" данных в Sing-box.)
  // ══════════════════════════════════════════════
  "inbounds": [
    // Используем тип TProxy как самый оптимальный
    { "tag": "tproxy-in", "type": "tproxy", "listen": "::", "listen_port": 65082, "tcp_fast_open": true, "udp_fragment": true, "udp_timeout": "1m0s" }
  ],

  // ══════════════════════════════════════════════
  // Конфигурация Outbounds - исходящие подключения
  // Как трафик "выходит": прямое соединение/прокси-узел
  // ══════════════════════════════════════════════
  "outbounds": [
    // Селекторы для переключения прокси в панели Zashboard
    { "tag": "🌍 Выбор узла", "type": "selector", "outbounds": [ "⚡️ Авто 🌍", "🆚 vless узел 🌍" ], "default": "🆚 vless узел 🌍", "interrupt_exist_connections": true },
    { "tag": "🇷🇺 Россия", "type": "selector", "outbounds": [ "🔌 Провайдер", "⚡️ Авто 🇷🇺", "🆚 vless узел 🇷🇺" ], "default": "⚡️ Авто 🇷🇺", "interrupt_exist_connections": true },
    { "tag": "🏴‍☠️ Торрент", "type": "selector", "outbounds": [ "🔌 Провайдер", "⚡️ Авто 🌍", "🆚 vless узел 🌍" ], "default": "⚡️ Авто 🌍", "interrupt_exist_connections": true },
    { "tag": "🕹️ Игры", "type": "selector", "outbounds": [ "🔌 Провайдер", "⚡️ Авто 🌍", "🆚 vless узел 🌍" ], "default": "⚡️ Авто 🌍", "interrupt_exist_connections": true },
    { "tag": "🤖 AI", "type": "selector", "outbounds": [ "🔌 Провайдер", "⚡️ Авто 🌍", "🆚 vless узел 🌍" ], "default": "⚡️ Авто 🌍", "interrupt_exist_connections": true },
    { "tag": "🔌 Провайдер", "type": "selector", "outbounds": [ "DIRECT" ] },
    // Прямое подключение к правайдеру (DIRECT)
    { "tag": "DIRECT", "type": "direct", "domain_resolver": "dns_direct" },
    // Глобальное подключение в качестве обходного маршрута для загрузки rule_set, zashboard веб панели и обработки DNS-запросов проксируемого трафика.
    { "tag": "GLOBAL", "type": "selector", "outbounds": [ "🌍 Выбор узла" ], "interrupt_exist_connections": true },

    // Список прокси-узлов
    {
      "tag": "🆚 vless узел 🌍",
      "type": "vless",
      "uuid": "00000000-0000-0000-0000-00000000000",
      "flow": "xtls-rprx-vision",
      "packet_encoding": "xudp",
      "server": "example.com",
      "server_port": 443,
      "tls": { "enabled": true, "server_name": "example.com", "utls": { "enabled": true, "fingerprint": "qq" } }
    },
    {
      "tag": "🆚 vless узел 🇷🇺",
      "type": "vless",
      "uuid": "00000000-0000-0000-0000-00000000000",
      "flow": "xtls-rprx-vision",
      "packet_encoding": "xudp",
      "server": "example.ru",
      "server_port": 443,
      "tls": { "enabled": true, "server_name": "example.ru", "utls": { "enabled": true, "fingerprint": "qq" } }
    },

    // ...Примеры других (рабочих) типов узлов смотрите в фале outbounds.json

    // Группы автоматического измерения задержки (доступности прокси-узлов)
    // Примечание: Проводят тест задержки на всех указанных в outbounds узлах каждые 10 минут и выбирайте тот, у которого наименьшая задержка.
    // tolerance=100: Можно выбрать любой узел с задержкой в ​​пределах 100 мс от максимальной задержки (балансировка нагрузки).
    { "tag": "⚡️ Авто 🌍", "type": "urltest", "outbounds": [ "🆚 vless узел 🌍" ], "interval": "10m", "tolerance": 100, "interrupt_exist_connections": true },
    { "tag": "⚡️ Авто 🇷🇺", "type": "urltest", "outbounds": [ "🆚 vless узел 🇷🇺" ], "interval": "10m", "tolerance": 100, "interrupt_exist_connections": true }
  ],

  // ══════════════════════════════════════════
  // Конфигурация маршрутизации — определяет,
  // использует ли каждое соединение прямое соединение или прокси-сервер.
  // ════════════════════════════════════════════
  "route": {
    "rules": [
      // Правило 1: Направять ICMP-пинги минуя прокси → Предотвращение утечек данных!
      // Правило необходимо если планируете использовать что-то кроме Redirect/TProxy/Hybrid
      { "network": "icmp", "outbound": "🔌 Провайдер" },

      // Правило 2: Сниффинг/Определение протокола
      // Извлечение доменного имени из поля SNI запроса TLS ClientHello
      // Извлечение доменного имени из заголовка Host HTTP-запроса
      // Результаты сниффинга используются для последующих правил определения доменных имен
      // action=sniff само по себе не определяет точку выхода, оно только извлекает доменное имя
      { "action": "sniff", "timeout": "500ms" },

      // Правило 3: Перехват DNS (порт 53 + протокол DNS)
      // Перехват обычных DNS-запросов к внутреннему DNS-модулю Sing-box → Предотвращение утечек данных!
      // Логическое ИЛИ: Порт 53 или протокол DNS; перехват происходит, если выполняется хотя бы одно из этих условий.
      { "action": "hijack-dns", "type": "logical", "mode": "or", "rules": [ { "protocol": "dns" }, { "port": 53 } ] },

      // Правило 4: Отклонить DoT(853) и mDNS(5353) → Предотвращает обход DNS-перехвата sing-box
      // DoT = DNS поверх TLS, зашифрованный DNS, обходящий перехват → Предотвращает возврат к порту 53
      // mDNS = Обнаружение устройств локальной сети осуществляется системой и не требует прокси-сервера.
      { "port": [ 853, 5353 ], "action": "reject" },

      // Правило 5: Отклонять недействительные публичные IPv6-адреса
      // Если маршрутизатор не назначил публичный IPv6-адрес (2000::/3), отклонять весь трафик IPv6
      // Предотвращает утечку прямых IPv6-соединений
      { "action": "reject", "type": "logical", "mode": "and", "rules": [ { "ip_version": 6 }, { "default_interface_address": "2000::/3", "invert": true } ] },

      // Правило 6: Синхронизация времени NTP
      // Отправляем в селектор "🇷🇺 Россия" чтобы гибко управлять трафиком NTP в роутере
      { "protocol": [ "ntp" ], "outbound": "🇷🇺 Россия" },

      // Правило 7: Локальный REJECT для зарубежного QUIC (UDP/443). Предотвращает таймауты браузера при блокировке DPI-системами.
      // ВАЖНО !!! Необходимо сначала убедиться, что с этим у вас действительно есть проблемы! А затем раскомментируйте правило ниже.
      // { "action": "reject", "type": "logical", "mode": "and", "rules": [ { "protocol": "quic" }, { "rule_set": "ru_ip", "invert": true } ] },

      // Правило 8: Защищает от утечек реального IP через WebRTC, но может ломать P2P-звонки (Discord, Telegram и др.)
      { "protocol": [ "stun" ], "action": "reject" },

      // Правило 9: Отклоняем домены сервисов проверки гео-IP.
      // Полностью запрещает запросы к детекторам IP-адресов. Это немного гарантирует, что
      // ни ваш реальный IP-адрес, ни IP-адрес прокси-сервера не будут раскрыты
      // встроенными антифрод-системами внутри зловредных приложений.
      // ! 2ip.ru, 2ip.io и т.п. не откроются, это необходимая мера!
      { "rule_set": [ "ip_geo_detect"], "action": "reject" },

      // Правило 10: Режим Clash "Direct"; да, так ему тут и надо.
      { "clash_mode": "Direct", "outbound": "🔌 Провайдер" },

      // Правило 11: Приватные домены и локальные сервисы чебурнета через провайдера.
      { "rule_set": [ "private", "cheburnet"], "outbound": "🔌 Провайдер" },

      // Правила 12: Назаначаем выходы (outbound) Нашим "Гибким" селекторам
      { "protocol": "bittorrent", "outbound": "🏴‍☠️ Торрент" },
      { "rule_set": [ "proxy" ], "outbound": "🌍 Выбор узла" },
      { "rule_set": [ "games" ], "outbound": "🕹️ Игры" },
      { "rule_set": [ "ai" ], "outbound": "🤖 AI" },
      { "rule_set": [ "ru" ], "outbound": "🇷🇺 Россия" },

      // Правило 13: Частные IP-адреса (192.168.xx и т. д.) → Прямой доступ
      { "ip_is_private": true, "outbound": "🔌 Провайдер" },

      // Правило 14: Поддельные диапазоны IP-адресов → ПРОКСИ.
      // Весь трафик за Fake-IP является фиктивным и должен проходить через прокси-сервер.
      { "ip_cidr": [ "198.18.0.0/15",  "fc00::/18" ], "outbound": "🌍 Выбор узла" },

      // Правило 15: RU айпи (не в блоке) в селектор "🇷🇺 Россия"
      { "rule_set": [ "ru_ip" ], "outbound": "🇷🇺 Россия" },

      // Правило 16: Параметры маршрутизации UDP
      // Отключить обратный поиск домена UDP, включить режим подключения UDP
      { "action": "route-options", "udp_disable_domain_unmapping": true, "udp_connect": true },
        // Назначение функции udp_connect:
        // Назначая каждому UDP-соединению конкретный адрес назначения, sing-box может обеспечить точную маршрутизацию.
        // Недостаток: не поддерживает приложения, отправляющие UDP-сообщения нескольким адресатам (очень редко).

      // Правило 17: Разрешение доменного имени
      // Для подключений, которые ранее не были сопоставлены, сначала разрешите доменное имя, а затем повторно сопоставляем правила.
      // Например, если настроены только правила для доменных имен, но подключение идет напрямую к IP-адресу.
      { "action": "resolve" },

      // Правило 18: Глобальный Clash-режим через "🌍 Выбор узла" после всех правил,
      // для принудительного их использования в этом режиме
      { "clash_mode": "Global", "outbound": "🌍 Выбор узла" }
    ],

    // Наборы правил (12 шт)
    // Автоматическое обновление каждые 24 часа
    // Использует http_client: по умолчанию = "🌍 Выбор узла" для загрузки
    "rule_set": [
      { "tag": "adguard", "type": "remote", "url": "https://github.com/jinndi/adguard-filter-list-srs/releases/latest/download/adguard-filter-list.srs" },
      { "tag": "private", "type": "remote", "url": "https://github.com/KaringX/karing-ruleset/raw/sing/geo/geosite/private.srs" },
      { "tag": "fakeip_filter", "type": "remote", "url": "https://github.com/jinndi/fakeip-filter-srs/releases/latest/download/fakeip-filter.srs" },
      { "tag": "trackerslist", "type": "remote", "url": "https://github.com/KaringX/karing-ruleset/raw/sing/geo/geosite/category-public-tracker.srs" },
      { "tag": "games", "type": "remote", "url": "https://github.com/KaringX/karing-ruleset/raw/sing/geo/geosite/category-games.srs" },
      { "tag": "ai", "type": "remote", "url": "https://github.com/KaringX/karing-ruleset/raw/sing/geo/geosite/category-ai-chat-!cn.srs" },
      { "tag": "proxy", "type": "remote", "url": "https://github.com/KaringX/karing-ruleset/raw/sing/russia/runetfreedom/sing-box/rule-set-geosite/geosite-ru-blocked.srs" },
      { "tag": "ip_geo_detect", "type": "remote", "url": "https://github.com/KaringX/karing-ruleset/raw/sing/geo/geosite/category-ip-geo-detect.srs" },
      { "tag": "cheburnet", "type": "remote", "url": "https://github.com/jinndi/geosite-cheburnet/releases/latest/download/geosite-cheburnet.srs" },
      { "tag": "ru", "type": "remote", "url": "https://github.com/KaringX/karing-ruleset/raw/sing/geo/geosite/category-ru.srs" },
      { "tag": "ru_ip", "type": "remote", "url": "https://github.com/KaringX/karing-ruleset/raw/sing/geo/geosite/ru.srs" },
      { "tag": "ru_ip_blocked", "type": "remote", "url": "https://github.com/KaringX/karing-ruleset/raw/sing/russia/runetfreedom/sing-box/rule-set-geoip/geoip-ru-blocked.srs" }
    ],

    // Глобальные настройки маршрутизатора
    "final": "🌍 Выбор узла",   // Крайний вариант: если ни одно правило не подходит → Используйте прокси из "🌍 Выбор узла"
    "auto_detect_interface": true,   // Автоматическое определение сетевого интерфейса
    "default_domain_resolver": "dns_direct", // По умолчанию уровень маршрутизации использует DNS-серверы Yandex при разрешении доменных имен.
    "default_http_client": "global_client"  // http_client в качестве обходного маршрута для загрузки rule_set
  },

  // ══════════════════════════════════════════
  // Экспериментальные функции
  // ═══════════════════════════════════════════
  "experimental": {
    // Файл кэша
    // Сохранение таблицы сопоставления fakeip и кэша DNS в cache.db
    // После перезапуска sing-box восстанавливается мгновенно.
    "cache_file": {
      "enabled": true,      // Включить кэширование
      "path": "cache.db",   // Путь к файлу кэша
      "cache_id": "",       // Идентификатор кэша (используется для разделения разных кэшей при переключении конфигураций)
      "store_fakeip": true, // Сохранение поддельных IP-доменов → сопоставление поддельных IP-адресов
      "store_dns": true     // Сохранить в кэш разрешения DNS
    },

    // API Clash
    // Предоставляет REST API, совместимый с Clash, которым можно управлять через такие панели, как Yacd, Zashboard и т.д.
    "clash_api": {
      "external_controller": "0.0.0.0:9999", // Адрес прослушивания API
      "external_ui": "zashboard",            // Каталог файлов веб-панели
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist-no-fonts.zip", // URL адрес Zashboard .zip панели
      "external_ui_download_detour": "GLOBAL", // Скачивание файлов панели через глобальный селектор
      "default_mode": "Rule"   // Режим правил по умолчанию
    },

    // Ограничение использования памяти
    // (уменьшите или увеличьте в зависимости от устройства, если памяти достаточно, не стоит sing-box ограничивать)
    "debug": {
      "gc_percent": 100, // Порог срабатывания сборки мусора по умолчанию (сборка мусора начинается только при удвоении объема используемой памяти)
      "memory_limit": "200MB" // Мягкое ограничение объема памяти, активная сборка мусора при приближении к нему.
    }
  }
}
