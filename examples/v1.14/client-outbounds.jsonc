// Примеры конфигурации прокси узлов на стороне клиента sing-box (дополняется)
// На стороне сервера смотрите в файле examples/v1.14/Server-sing-box.md
// ! В server_port указывайте свои значения портов.

[
  // 1. NaïveProxy (режим TCP с UoT)
  // Протокол NaïveProxy (протокол прокси Chrome), туннелирование TLS+HTTP/2
  // udp_over_tcp: true - трафик UDP передается через TCP-туннель
  {
    "type": "naive",
    "tag": "naive-tcp",
    "server": "<ваш.домен.com>",
    "server_port": 1443,
    "username": "<ваш_имя_пользователя>",
    "password": "<ваш_пароль>",
    "udp_over_tcp": true,
    "tls": {
      "enabled": true,
      "server_name": "<ваш.домен.com>"
    }
  },

  // 1.1. NaïveProxy (режим QUIC)
  // Тот же сервер, что и в первом варианте, но использует QUIC для передачи данных + управление перегрузкой BBR
  // udp_over_tcp: false - QUIC имеет встроенную поддержку UDP
  {
    "type": "naive",
    "tag": "naive-quic",
    "server": "<ваш.домен.com>",
    "server_port": 1443,
    "username": "<ваш_имя_пользователя>",
    "password": "<ваш_пароль>",
    "udp_over_tcp": false,
    "quic": true,
    "quic_congestion_control": "bbr",
    "tls": {
      "enabled": true,
      "server_name": "<ваш.домен.com>"
    }
  },

  // 2. Trojan-TLS + Multiplex
  {
    "type": "trojan",
    "tag": "trojan-tls-mux",
    "password": "<ваш_пароль>",
    "server": "<ваш.домен.com>",
    "server_port": 2443,
    "connect_timeout": "5s",
    "tcp_fast_open": true,
    "tcp_keep_alive": "30s",
    "tcp_keep_alive_interval": "5s",
    "udp_fragment": true,
    "tls": {
      "enabled": true,
      "server_name": "<ваш.домен.com>",
      // Если отпечатки блокируются, uTLS можно отключить
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "multiplex": {
      "enabled": true,
      "max_connections": 6,
      "max_streams": 48,
      "protocol": "h2mux"
    }
  },

  // 3. Trojan-TLS-WS + Multiplex за Cloudflare
  {
    "type": "trojan",
    "tag": "trojan-cf-mux",
    "password": "<ваш_пароль>",
    "server": "<ваш_домен.com>",
    "server_port": 2096,
    "connect_timeout": "5s",
    "tcp_keep_alive": "30s",
    "tcp_keep_alive_interval": "5s",
    "udp_fragment": true,
    "tls": {
      "enabled": true,
      "server_name": "<ваш_домен.com>",
      "spoof": "yandex.ru", // Внедрить поддельный TLS ClientHello (индивидуально),
                            // содержащий разрешенный SNI, перед реальным, чтобы обмануть промежуточные устройства,
                            // фильтрующие SNI и разрешающие определенные имена хостов.
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "transport": {
      "type": "ws",
      "path": "/secret-path" // Ваш секретный путь (совпадает с конфигурацией сервера)
    },
    "multiplex": {
      "enabled": true,
      "max_connections": 6,
      "max_streams": 48,
      "protocol": "h2mux"
    }
  },

  // 4. Hysteria2
  {
    "type": "hysteria2",
    "tag": "hy2",
    "server": "<ваш.домен.com>",
    "server_port": 12443, // Игронируется если настроена смена портов.
    // Смена портов. (Не актуально для РФ)
    // Только если вы настроили на сервере:
    // - перенаправление с диапазона: https://hysteria.network/ru/docs/advanced/Port-Hopping/#__tabbed_2_1
    // - открыли сам дипазон портов в фаерволе.
    // "server_ports": [ "51000:52000" ],  // Список диапазонов портов сервера. (антиблокировка)
    // "hop_interval": "30s",       // Минимальный интервал переключения портов.
    // "hop_interval_max": "1m0s",  // Максимальный интервал переключения портов.
    "up_mbps": 100,    // Максимальная скорость отдачи (Upload) твоего провайдера для Brutal BBR
    "down_mbps": 100,  // Максимальная скорость скачивания (Download) твоего провайдера для Brutal BBR
    "password": "<ваш_пароль_пользователя>",
    // Если на сервере включена обускация QUIC (не для мобильных сетей)
    // "obfs": {
    //   "type": "gecko",
    //   "password": "<ваш_пароль_обфускации_quic>"
    // }
    "tls": {
      "enabled": true,
      "server_name": "<ваш.домен.com>",
      "alpn": [ "h3" ]
    },
    "stream_receive_window": 0,
    "connection_receive_window": 0
  },

  // 5. Hysteria2 с Realm (Cloudflare Workers)
  {
    "type": "hysteria2",
    "tag": "hy2-realm",
    "up_mbps": 100,    // Максимальная скорость отдачи (Upload) твоего провайдера для Brutal BBR
    "down_mbps": 100,  // Максимальная скорость скачивания (Download) твоего провайдера для Brutal BBR
    "password": "<ваш_пароль_пользователя>",
    // Если на сервере включена обускация QUIC (не для мобильных сетей)
    // "obfs": {
    //   "type": "gecko",
    //   "password": "<ваш_пароль_обфускации_quic>"
    // }
    "tls": {
      "enabled": true,
      "server_name": "<ваш.домен.com>",
      "alpn": [ "h3" ]
    },
    "stream_receive_window": 0,
    "connection_receive_window": 0,
    "realm": {
      "server_url": "https://<ваш.домен>.workers.dev",
      "token": "<ваш_токен>",
      "realm_id": "<ваш_идентификатор>",
      // Список STUN-серверов для NAT Traversal
      "stun_servers": [
        "turn.cloudflare.com:3478",
        "stun.nextcloud.com:3478",
        "stun1.l.google.com:19302"
      ],
      // Если домен указанный в server_url заблокирован (а для .workers.dev это так),
      // Указываем в detour тег узла через которое будет обращение к нему,
      // иначе блок http_client можно удалить.
      "http_client": {
        "detour": "trojan-cf-mux"
      }
    }
  }

  // ... продолжение следует
]
