// Примеры конфигурации прокси узлов на стороне клиента sing-box (дополняется)
// На стороне сервера смотрите в файле examples/v1.14/Server-sing-box.md
// ! В server_port указывайте свои значения портов.

[
  // 1. NaïveProxy (режим TCP с UoT)
  // Протокол NaïveProxy (протокол прокси Chrome), туннелирование TLS+HTTP/2
  // udp_over_tcp: true - трафик UDP передается через TCP-туннель
  {
    "type": "naive",
    "tag": "naive-tcp",
    "server": "<ваш.домен.com>",
    "server_port": 1443,
    "username": "<ваш_имя_пользователя>",
    "password": "<ваш_пароль>",
    "udp_over_tcp": true,
    "tls": {
      "enabled": true,
      "server_name": "<ваш.домен.com>"
    }
  },

  // 1.1. NaïveProxy (режим QUIC)
  // Тот же сервер, что и в первом варианте, но использует QUIC для передачи данных + управление перегрузкой BBR
  // udp_over_tcp: false - QUIC имеет встроенную поддержку UDP
  {
    "type": "naive",
    "tag": "naive-quic",
    "server": "<ваш.домен.com>",
    "server_port": 1443,
    "username": "<ваш_имя_пользователя>",
    "password": "<ваш_пароль>",
    "udp_over_tcp": false,
    "quic": true,
    "quic_congestion_control": "bbr",
    "tls": {
      "enabled": true,
      "server_name": "<ваш.домен.com>"
    }
  },

  // 2. Trojan-TLS + Multiplex
  {
    "type": "trojan",
    "tag": "trojan-tls-mux",
    "password": "<ваш_пароль>",
    "server": "<ваш.домен.com>",
    "server_port": 2443,
    "connect_timeout": "5s",
    "tcp_fast_open": true,
    "tcp_keep_alive": "30s",
    "tcp_keep_alive_interval": "5s",
    "udp_fragment": true,
    "tls": {
      "enabled": true,
      "server_name": "<ваш.домен.com>",
      "certificate_public_key_sha256": "<ваш_хэш_открытого_ключа>",
      // Если отпечатки блокируются, uTLS можно отключить
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "multiplex": {
      "enabled": true,
      "max_connections": 6,
      "max_streams": 48,
      "protocol": "h2mux"
    }
  },

  // 3. Trojan-TLS-WS + Multiplex за Cloudflare
  {
    "type": "trojan",
    "tag": "trojan-cf-mux",
    "password": "<ваш_пароль>",
    "server": "<ваш_домен.com>", // Домен, использующий CDN
    "server_port": 2096,
    "connect_timeout": "5s",
    "tcp_keep_alive": "30s",
    "tcp_keep_alive_interval": "5s",
    "udp_fragment": true,
    "tls": {
      "enabled": true,
      "server_name": "<ваш_домен.com>",
      "certificate_public_key_sha256": "<ваш_хэш_открытого_ключа>",
      "spoof": "yandex.ru", // Внедрить поддельный TLS ClientHello (подбирается индивидуально),
                            // содержащий разрешенный SNI, перед реальным, чтобы обмануть промежуточные устройства,
                            // фильтрующие SNI и разрешающие определенные имена хостов.
                            // ВАЖНО: Требует ROOT прав (в Entware имеются)
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "transport": {
      "type": "ws",
      "path": "/secret-path" // Ваш секретный путь (совпадает с конфигурацией сервера)
    },
    "multiplex": {
      "enabled": true,
      "max_connections": 6,
      "max_streams": 48,
      "protocol": "h2mux"
    }
  },

  // 4. Vmess-TLS-WS за Cloudflare с uTLS, Multiplex и Brutal BBR.
  {
    "type": "vmess",
    "tag": "vmess-cf-brutal",
    "server": "<ваш_домен.com>", // Домен, использующий CDN
    "server_port": 2083,
    "uuid": "<ваш_uuid>",  // Совпадает с конфигурацией сервера для конкретного пользователя
    "security": "auto",    // Метод шифрования - автоматический
    "tls": {
      "enabled": true,
      "server_name": "<ваш_домен.com>",
      "spoof": "yandex.ru",  // Без этого параметра соединение в РФ к CDN Cloudflare не установится,
                             // подберите своё значение SNI.
      "certificate_public_key_sha256": "<ваш_хэш_открытого_ключа>",
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "packet_encoding": "xudp", // Оптимизация UDP-трафика (метод упаковки)
    "transport": {
      "type": "ws",
      "path": "/secret-path" // Ваш секретный путь (совпадает с конфигурацией сервера)
    },
    "multiplex": {
      "enabled": true,
      "protocol": "h2mux",
      "max_connections": 4, // Сколько реальных TCP/TLS соединений (физических каналов) открывать до сервера
      "max_streams": 16,    // Сколько отдельных запросов/сайтов можно упаковать внутрь ОДНОГО соединения
      "padding": true,      // Включить добавление случайных байтов в заголовки пакетов
      "brutal": {
        "enabled": true,
        "up_mbps": 15,  // Подстройка скорости отдачи Мегабит/с (Upload) для Brutal BBR
        "down_mbps": 50  // Подстройка скорости скачивания Мегабит/с (Download) для Brutal BBR
      }
    }
  },

  // 5. Snell V6 | В версии 6 обфускация HTTP версии заменена на shaping трафика (mode).
  // Данную версию лучше всего использовать для построения приватного каскада (Proxy Chain)
  // поверх коммерческих подписок («аэропортов»):
  // Схема: [Клиент] -> Snell -> VLESS (транспорт подписки) -> Snell -> [Ваш VPS]
  // Владелец подписки выступает лишь «слепым» перевозчиком - он видит только поток Snell,
  // но не может расшифровать ваши DNS и трафик без psk-ключа.
  {
    "type": "snell",
    "tag": "snell-v6",
    "server": "<ваш_домен_или_ip>",
    "server_port": 3443,
    "version": 6,
    "psk": "<ваш_приватный_ключ>",
    "userkey": "<ваш_ключ_пользователя>",
    "reuse": true,
    "mode": "default" // "unshaped" - если используем через другой прокси (VLESS)
    //, "detour": "VLESS-OUT" // Тег VLESS-подключения для направления трафика через него.
  },

  // 5.1. Snell V4 | Не поддерживается режим прокси QUIC в Snell v5,
  // поддерживается обфускация HTTP (obfs_mode / obfs_host);
  // протокол передачи данных v5 фактически идентичен протоколу v4,
  // поэтому отдельный сервер v4 или клиент v5 не предоставляются.
  {
    "type": "snell",
    "tag": "snell-v4",
    "server": "<ваш_домен_или_ip>",
    "server_port": 4443,
    "version": 4,
    "psk": "<ваш_приватный_ключ>",
    "userkey": "<ваш_ключ_пользователя>",
    "reuse": true,
    "obfs_mode": "http",
    "obfs_host": "yandex.ru" // Заголовок HTTP Host, отправляемый, когда obfs_mode имеет значение http.
                             // По умолчанию используется bing.com.
  },

  // 6. AnyTLS | TLS-туннелирование, автоматическое обслуживание пула соединений
  {
    "type": "anytls",
    "tag": "anytls",
    "server": "<ваш.домен.com>",
    "server_port": 5443,
    "tls": {
      "enabled": true,
      "server_name": "<ваш_домен.com>",
      "certificate_public_key_sha256": "<ваш_хэш_открытого_ключа>",
      "utls": {
        "enabled": true,
        "fingerprint": "firefox"
      }
      // PS. Если не работает с utls, попробуйте настроить через самоподписанный сертификат,
      // но обазательно с certificate_public_key_sha256, либо отключите utls вовсе.
    },
    "password": "<ваш_пароль>",
    "idle_session_check_interval": "30s", // Проверка интервала для неактивных сессий (30 сек)
    "idle_session_timeout": "30s",        // При проверке закрывать сессии, которые в режиме ожидания дольше 30 сек.
    "min_idle_session": 5                 // Поддерживать как минимум 5 активных соединений
  },

  // 7. VLESS-TLS-WS за Cloudflare с поддержкой Multiplex и Brutal BBR.
  {
    "type": "vless",
    "tag": "vless-cf-brutal",
    "server": "<ваш.домен.com>",
    "server_port": 2087,
    "connect_timeout": "5s",
    "tcp_keep_alive": "30s",
    "tcp_keep_alive_interval": "5s",
    "uuid": "<ваш_uuid>",
    "tls": {
      "enabled": true,
      "server_name": "<ваш.домен.com>",
      "spoof": "yandex.ru",
      "certificate_public_key_sha256": "<ваш_хэш_открытого_ключа>",
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "transport": {
      "type": "ws",
      "path": "/secret-path" // Ваш секретный путь (совпадает с конфигурацией сервера)
    },
    "multiplex": {
      "enabled": true,
      "max_connections": 6,
      "max_streams": 48,
      "protocol": "h2mux",
      "brutal": {
        "enabled": true,
        "up_mbps": 50,
        "down_mbps": 100
      }
    }
  },

  // 8. Shadowsocks 2022 UDP-over-TCP (UoT) и Multiplex через ShadowTLS V3
  // Используем ShadowTLS в качестве выхода шифрованного Shadowsocks трафика.
  // ВАЖНО!: Не используте в селекторах ShadowTLS узел напрямую,
  // а лучше не включаейте его в них, т.к. сам по себе он не шифрует трафик.
  {
    "type": "shadowsocks",
    "tag": "ss->shadowtls",
    "method": "2022-blake3-aes-128-gcm",
    "password": "<ваш_пароль>",
    "udp_over_tcp": {
      "enabled": true,
      "version": 2
    },
    "multiplex": {
      "enabled": true,
      "protocol": "h2mux",
      "max_connections": 4,
      "max_streams": 16
    },
    "detour": "shadowtls" // Направляем трафик через tag=shadowtls
  },
  {
    "type": "shadowtls",
    "tag": "shadowtls",
    "server": "<ваш_домен_или_ip>",
    "server_port": 6443,
    "version": 3,
    "password": "<ваш_пароль>",
    "tls": {
      "enabled": true,
      "server_name": "<сайт.маскировки>", // Указан на сервере
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    }
  },

  // 9. Hysteria2
  {
    "type": "hysteria2",
    "tag": "hy2",
    "server": "<ваш.домен.com>",
    "server_port": 12443, // Игронируется если настроена смена портов.
    // Смена портов. (Не актуально для РФ)
    // Только если вы настроили на сервере:
    // - перенаправление с диапазона: https://hysteria.network/ru/docs/advanced/Port-Hopping/#__tabbed_2_1
    // - открыли сам дипазон портов в фаерволе.
    // "server_ports": [ "51000:52000" ],  // Список диапазонов портов сервера. (антиблокировка)
    // "hop_interval": "30s",       // Минимальный интервал переключения портов.
    // "hop_interval_max": "1m0s",  // Максимальный интервал переключения портов.
    "up_mbps": 100,    // Максимальная скорость отдачи (Upload) твоего провайдера для Brutal BBR
    "down_mbps": 100,  // Максимальная скорость скачивания (Download) твоего провайдера для Brutal BBR
    "password": "<ваш_пароль_пользователя>",
    // Если на сервере включена обфускация QUIC (не для мобильных сетей)
    // "obfs": {
    //   "type": "gecko",
    //   "password": "<ваш_пароль_обфускации_quic>"
    // }
    "tls": {
      "enabled": true,
      "server_name": "<ваш.домен.com>",
      "certificate_public_key_sha256": "<ваш_хэш_открытого_ключа>",
      "alpn": [ "h3" ]
    },
    // Размеры окон приема потока и соединения. Установите 0 для автоматического определения.
    "stream_receive_window": 0,
    "connection_receive_window": 0
  },

  // 9.1. Hysteria2 с Realm (Cloudflare Workers)
  {
    "type": "hysteria2",
    "tag": "hy2-realm",
    "up_mbps": 100,    // Максимальная скорость отдачи (Upload) твоего провайдера для Brutal BBR
    "down_mbps": 100,  // Максимальная скорость скачивания (Download) твоего провайдера для Brutal BBR
    "password": "<ваш_пароль_пользователя>",
    // Если на сервере включена обфускация QUIC (не для мобильных сетей)
    // "obfs": {
    //   "type": "gecko",
    //   "password": "<ваш_пароль_обфускации_quic>"
    // }
    "tls": {
      "enabled": true,
      "server_name": "<ваш.домен.com>",
      "certificate_public_key_sha256": "<ваш_хэш_открытого_ключа>",
      "alpn": [ "h3" ]
    },
    "stream_receive_window": 0,
    "connection_receive_window": 0,
    "realm": {
      "server_url": "https://<ваш.домен>.workers.dev",
      "token": "<ваш_токен>",
      "realm_id": "<ваш_идентификатор>",
      // Список STUN-серверов для NAT Traversal
      "stun_servers": [
        "stun.sipnet.ru:3478",
        "stun.miwifi.com:3478",
        "stun.nextcloud.com:3478"
      ],

      // "ip_version": 4,  // Ограничить количество соединений в рамках домена одной версией IP-адреса.
      //                   // (STUN, пробитие дыры и результирующий путь QUIC), !!! необходимо для port_mapping
      // // Настройка сопоставления UDP-портов на локальном шлюзе с помощью UPnP или NAT-PMP.
      // // Схема устанавливается до обнаружения STUN и повышает надежность пробития дыр за шлюзами,
      // // которые ее поддерживают; сбои не являются фатальными.
      // // ВАЖНО!: В Keenetic/Netcraze необходимо установить компонент "Служба UPnP".
      // "port_mapping":{
      //   "enabled": true,    // Включает автоматический проброс UDP-порта на вашем домашнем роутере через протоколы UPnP
      //   "timeout": "10s",   // Время, которое sing-box готов ждать ответа от роутера при поиске UPnP шлюза.
      //   "lifetime": "10m"   // Время "аренды" порта на роутере. По умолчанию 10m (10 минут).
      //                       // Роутеры обычно закрывают неиспользуемые порты UPnP через какое-то время,
      //                       // поэтому sing-box будет автоматически обновлять эту аренду каждые 5 минут (половина от заданного lifetime).
      // },

      // Если домен указанный в server_url заблокирован (а для .workers.dev это так),
      // Указываем в detour тег узла через которое будет обращение к нему,
      // иначе блок http_client можно удалить.
      "http_client": {
        "detour": "trojan-tls-mux"
      }
    }
  },

  // 10. TUIC
  {
    "type": "tuic",
    "tag": "tuic-bbr",
    "server": "<ваш.домен.com>",
    "server_port": 12443,
    "uuid": "<ваш_uuid>",
    "password": "<ваш_пароль>",
    "congestion_control": "bbr", // Алгоритм управления перегрузкой BBR
    "udp_relay_mode": "native",  // Собственная переадресация UDP
    "heartbeat": "10s",          // 10-секундный пульс
    "tls": {
      "enabled": true,
      "server_name": "<ваш.домен.com>",
      "certificate_public_key_sha256": "<ваш_хэш_открытого_ключа>",
      "alpn": [ "h3" ]
    },
    "stream_receive_window": 0,
    "connection_receive_window": 0
  }

  // ... продолжение следует
]
