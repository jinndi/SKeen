//// Конфигурация для шаблонов по умолчанию при выходе стабильной версии sing-box 1.14
//// С комментариями, заточенная специально для России и всех типов операторов связи.

// 0. Чебурнет здесь.

// 1. Пожалуйста, скорректируйте шаблон в соответствии с вашей ситуацией.
// Лучший шаблон - тот, который вам больше всего подходит.
// Если у вас нет особых требований, вы можете скопировать всё дословно.

// 2. Это решение обеспечивает маршрутизацию RU-трафика через селектор "🇷🇺 RU" отдельно от Чебурнета,
// обход российских IP-адресов, а также неизвестных доменов, если их IP географически находятся в РФ и не заблокированы.
// Дополнительно предотвращаются утечки DNS и IP-адресов серверов подключения.

// 3. Почему не используется точечная маршрутизация?
// При точечном режиме (final: direct) через прокси идут только заблокированные сайты,
// а всё остальное - напрямую. Это создает критические уязвимости:
// - Утечка DNS (DNS Leaks): Без шифрования провайдер видит домен в DNS-запросе до срабатывания точечного прокси.
// - Анализ трафика (DPI/СОРМ): Не внесенный в списки сайт выдает себя провайдеру через открытый TLS SNI.
// - Человеческий фактор: Новые блокировки, CDN и скрытые API без ручного внесения пойдут напрямую, оставляя цифровой след и вызывая ошибки доступа.
// Вывод: Режим final: proxy (Белый список) - единственный способ гарантировать, что ни один неопознанный байт сетевой активности не утечет провайдеру.
// Попытки настроить точечный обход ради «производительности» неоправданны: экономия ресурсов ничтожна,
// но при этом полностью теряется приватность и безопасность для большей части трафика.

// 4. Рекомендуется установить параметр `client_subnet` в диапазон IP-адресов DNS-сервера по умолчанию,
// назначенного вашим текущим провайдером широкополосного доступа
// (это можно проверить на странице вашего роутера, или обратившись к общедоступному каталогу DNS).
// Например, если DNS-сервер по умолчанию - 77.88.8.8, вы можете установить его на 77.88.8.0/24.

// 5. Для работы селектора «🏴‍☠️ Torrent» убедитесь, что в торрент-клиенте для подключения к пирам выбран протокол «только TCP»
// и в настройках приватности не установлено принудительное шифрование.
// Скорость при прямом подключении создаёт нагрузку на процессор, сопоставимую с работой без маршрутизации трафика через sing-box.
// При этом решение сохраняет работоспособность в любых окружениях.

// 6. Узел GLOBAL использует селектор выбора узлов ("🌍 Proxy") в качестве обходного маршрута для загрузки rule_set,
// zashboard и обработки DNS-запросов проксируемого трафика.
// !!! ВАЖНО: в селекторе "🌍 Proxy" необходим рабочий узел по умолчанию как минимум для первого старта sing-box,
// для этого укажите его тег в параметре "default".

// 7. Заполнять узлы и синхронизировать сам конфиг через "skeen sync" можно, настроив Sub-Store (смотрите файл Sub-Store-sync.md)

{
  // ══════════════════════════════════════════════
  // Настройка логирования
  // ══════════════════════════════════════════════
  // Измените на fatal, чтобы видеть только фатальные ошибки, не для обычного логирования.
  // level="debug": чтобы увидеть полную цепочку логов во время отладки.
  // timestamp=true: Каждая запись в логе имеет метку времени, что упрощает отслеживание хронологии проблем.
  // Почему не использовать debug: Производительность роутеров ограничена, отладочные логи огромны (десятки в секунду),
  // fatal достаточно для повседневного использования.

  "log": { "disabled": false, "level": "debug", "output": "", "timestamp": false },

  // ══════════════════════════════════════════════
  // Конфигурация DNS - ядро ​​всей архитектуры,
  // определяющее разделение внутреннего и международного трафика
  // ══════════════════════════════════════════════
  "dns": {
    "servers": [
      // DNS-сервер 1: Файл hosts жестко закодирован локально ──
      // Назначение: Предварительная запись IP-адреса самого DNS-сервера во избежание бесконечного цикла "Разрешение DNS-сервера требует DNS-сервера"
      // Зачем это нужно: dns_direct необходимо подключиться к common.dot.dns.yandex.net, но common.dot.dns.yandex.net сам требует разрешения DNS
      // Файл hosts напрямую сообщает sing-box IP-адрес common.dot.dns.yandex.net, устраняя необходимость в отдельном поиске.
      {
        "tag": "hosts", "type": "hosts",
        "predefined": {
          "dns.google": [ "8.8.8.8", "8.8.4.4" ],
          "common.dot.dns.yandex.net": [ "77.88.8.8", "77.88.8.1" ]
        }
      },

      // DNS-сервер 2: Локальный роутера
      // Используем его для разрешения приватных доменов
      { "tag": "dns_local", "type": "local" },

      // DNS-сервер 3: Yandex DNS-over-HTTPS
      // Примечание: публичный DNS-сервер Yandex использует протокол HTTPS (порт 443) для зашифрованной передачи.
      // Почему используется HTTPS вместо обычного UDP 53?
      // Интернет-провайдеры внутри страны могут перехватывать DNS-запросы UDP 53, возвращая некорректные IP-адреса.
      // HTTPS использует порт 443 и зашифрован, поэтому его невозможно перехватить интернет-провайдерами.
      // Почему стоит использовать Yandex DNS: Единсвенный DNS сервер который будет/уже жив внутри страны.
      { "tag": "dns_direct", "type": "https", "server": "common.dot.dns.yandex.net", "domain_resolver": "hosts" },

      // DNS-сервер 4: Google DNS-over-HTTPS (альтернативный, используется редко)
      // Примечание: В крайних случаях для разрешения доменов используется прокси-сервер для подключения к DNS Google.
      { "tag": "dns_proxy",  "type": "https", "server": "dns.google", "domain_resolver": "hosts", "detour": "GLOBAL" },

      // DNS-сервер 5: FakeIP (для международного трафика)
      // Примечание: Вместо реального IP-адреса будет возвращен фиктивный IP-адрес (198.18.xx).
      // Зачем использовать FakeIP:
      // 1. Предотвращение утечек DNS: Иностранные доменные имена не используют вышестоящие DNS-серверы.
      // 2. Точная маршрутизация: трафик с использованием поддельных IP-адресов неизбежно будет проходить через прокси, предотвращая ложные срабатывания.
      // 3. Производительность: IP-адреса генерируются локально без поиска в сети.
      // Что такое 198.18.0.0/15: это тестовый сегмент сети, зарезервированный IANA; этот IP-адрес не существует в общедоступном интернете.
      // Что такое fc00::/18: уникальный локальный адрес IPv6, эквивалентный частному адресу в IPv6.
      { "tag": "dns_fakeip", "type": "fakeip", "inet4_range": "198.18.0.0/15", "inet6_range": "fc00::/18" }
    ],

    // Правила DNS: Доменное имя → Сопоставление DNS-серверов
    // Порядок очень важен! Сравнивайте сверху вниз, останавливается, когда найдено совпадение.
    "rules": [
      // Правило 1: Используем host в маршрутизации hosts DNS сервер
      { "preferred_by": [ "hosts" ], "server": "hosts" },

      // Правило 2: Отклонение всех IPv6 DNS-запросов (записи AAAA)
      // Если вам не нужен IPv6, прямое отклонение поможет избежать множества проблем.
      // Например, у некоторых сайтов есть IPv6, но прокси его не поддерживает, что приводит к ошибке подключения.
      // Эффект: браузер/приложение будут считать, что у домена нет IPv6-адреса
      // Пояснение: IPv6-маршрутизация внутри страны может быть несовершенной, отклонение уменьшает таймауты и повышает стабильность.
      { "ip_version": 6, "action": "reject" },

      // Правило 3: Защита от утечек: Блокировка запросов SVCB/HTTPS/PTR
      // SVCB/HTTPS: информация о соединении HTTP/3, может содержать реальные подсказки IP-адреса (ipv4hint/ipv6hint)
      // Если клиент получает реальный IP-адрес, он обходит подмену IP-адреса на поддельный.
      // PTR: Обратный поиск DNS (IP → доменное имя), не требуется для обычного использования.
      // После отклонения: клиент получает ответ об отклонении → автоматически повторяет поиск A (IPv4) / AAAA (IPv6).
      { "query_type": [ "SVCB", "HTTPS", "PTR" ], "action": "reject" },

      // Правило 4: Отклоняем домены сервисов проверки гео-IP.
      // Полностью запрещает запросы к детекторам IP-адресов. Это немного гарантирует, что
      // ни ваш реальный IP-адрес, ни IP-адрес прокси-сервера не будут раскрыты
      // встроенными антифрод-системами внутри зловредных приложений.
      // ! 2ip.ru, 2ip.io и т.п. не откроются, это необходимая мера!
      { "rule_set": [ "ipdetect"], "action": "reject" },

      // Правило 5: Резолвим домены с ключевыми словами "keenetic" и "netcraze" через локальный DNS роутера
      // Необходимо для работы KeenDNS и CrazeDNS.
      { "domain_keyword": [ "keenetic", "netcraze" ], "server": "dns_local" },

      // Правило 6: Приватные (локальные) DNS запросы обрабатываем DNS роутера
      { "rule_set": [ "private" ], "server": "dns_local" },

      // Правило 7: В режиме Clash Direct используем только dns_direct → Yandex DNS
      { "clash_mode": "Direct", "server": "dns_direct" },

      // Правило 8: Предопределенный DNS-ответ для блокировки рекламы.
      // По умолчанию sing-box ответит кодом NOERROR (запрос успешен), но не выдаст IP.
      // Это самый мягкий способ блокировки: приложения/сайты не зависают и не спамят повторными запросами.
      { "rule_set": [ "adguard" ], "action": "predefined" },

      // Правило 9: Для RU доменов белого списка -> разолвим через Yandex DNS
      { "rule_set": [ "cheburnet" ], "server": "dns_direct" },

      // Правило 10: Защита от перегрузки таблицы Fake-IP торрент-трекерами.
      { "rule_set": [ "trackers" ], "server": "dns_direct" },

      // Правило 11: Набор правил фильтрации → Yandex DNS
      // Примечание: файл filter.srs содержит список доменов, которые необходимо обходить с помощью поддельных IP-адресов.
      // Почему необходим обход: Некоторые домены, использующие поддельные IP-адреса, могут вызывать ошибки.
      { "rule_set": [ "filter" ], "server": "dns_direct" },

      // Правило 12: Для проксируемых доменов назначаем Fake-IP
      { "rule_set": [ "games", "ai", "proxy"], "query_type": [ "A", "AAAA" ], "rewrite_ttl": 300, "server": "dns_fakeip" },

      // Правило 13: Для доменов, которые не прошли по праавилам выше -> делаем оценку через прокси Google DNS
      { "action": "evaluate", "server": "dns_proxy", "client_subnet": "77.88.8.0/24" },

      // Правило 14: Ищем российские айпи (не в блоке), если находим -> завершаем цепочку правил и возвращаем результат
      { "match_response": true, "rule_set": [ "ruip" ], "action": "respond" },

      // Правило 15: Если полученный DNS-ответ не содержит IP-адреса -> завершаем цепочку правил и возвращаем результат
      { "match_response": true, "ip_accept_any": true, "invert": true, "action": "respond" },

      // Правило 16: Для зарубежных айпи (доменов) -> назначаем Fake-IP
      { "query_type": [ "A", "AAAA" ], "server": "dns_fakeip" },

      // Правило 17: Отклонять нестандартные запросы
      // query_type: Сопоставлять только записи A (IPv4) и AAAA (IPv6).
      // invert: true означает инвертирование совпадения, то есть совпадение со всеми типами, кроме A и AAAA.
      // Логика: Разрешать запросы только для записей A и AAAA; отклонять все остальные записи, такие как TXT, MX, NS и т. д.
      // Пояснение: В среде прозрачного прокси клиенту обычно нужен только IP-адрес,
      // и ему не требуются другие записи. Запрет доступа может предотвратить утечку информации.
      { "query_type": [ "A", "AAAA" ], "invert": true, "action": "reject" },

      // Правило 18: Для глобального режима Clash используем прокси FakeIP после всех правил
      // для принудительного их использования в этом режиме
      { "clash_mode": "Global", "server": "dns_fakeip" }
    ],

    // Глобальные настройки DNS
    "final": "dns_proxy",    // DNS в крайнем случае (в настоящее время заблокирован правилом 17, срабатывает редко)
    "strategy": "ipv4_only", // Политика DNS: Только IPv4
    // Ограничить возврат только адресами IPv4
    // Почему нет IPv6: Подавляющее большинство операторов не поддерживают IPv6.
    // Если возвращается IPv6-адрес, соединение переключается на IPv4 (дополнительная задержка).
    // Или же у вас может вообще не быть возможности подключиться (если сеть поддерживает IPv6, а провайдер — нет).
    // Установка значения ipv4_only позволит избежать этой проблемы.

    "timeout": "3s",         // Время ожидания DNS-запроса истекло через 3 секунды
    // Почему 3 секунды: Yandex DNS обычно возвращает результат дольше китайских аналогов на QUIC.
    // 3 секунды достаточно. Тайм-аут указывает на проблему с сетью. Быстрый сбой означает, что быстрая повторная попытка - лучший подход.

    "cache_capacity": 16384,  // Емкость кэша DNS: максимум 16384 записей.
    // 16384 достаточно для охвата всех часто используемых доменов и экономии памяти.
    // Роутеры имеют 256МБ-1ГБ памяти, и эта запись занимает примерно 10-20 МБ.
    // Когда кэш заполнится, старые записи будут удалены с использованием алгоритма LRU (Least Recently Used - наименее часто используемые).

    "optimistic": { "enabled": true, "timeout": "1h0m0s" }, // Оптимистическое кэширование DNS (срок истечения 1 час)
    // Принцип оптимистического кэширования:
    // 1. Если истекает срок действия DNS-записи (например, TTL=300 секунд), сначала верните старый результат (0 мс клиенту).
    // 2. Одновременно бэкэнд запрашивает новую информацию у Yandex DNS → незаметно обновляет кэш.
    // 3. Пользователи об этом не знают, и частота попаданий всегда равна 0 мс.
    // Почему 1 час: домены CDN видео меняются нечасто, и 1 часа достаточно.
    // Даже если кэш истечет через 1 час, будет выполнено повторное оптимистичное обновление.

    "reverse_mapping": true   // Включить обратное сопоставление DNS
    // Обратный поиск доменного имени по FakeIP (198.18.0.42 → youtube.com)
    // Ускорить сопоставление маршрутов и избежать дублирования перехвата трафика
  },

  // ==========================================
  // Модуль NTP - синхронизация сетевого времени
  // Используется для корректировки системного времени,
  // что крайне важно для установления TLS-соединения и служб, использующих метки времени.
  // ==========================================
  // Нужен ли вам этот блок?
  // Ответ:
  // 1. Если вы используете встроенный NTP в KeeneticOS и с ним нет проблем, то удалите этот блок.
  // 2. Если у вас Чебурнет и ни один NTP-сервер не пингуется — оставьте этот блок.
  // 3. Если вы не хотите использовать функцию проксирования роутера вместе с функцией NTP в KeeneticOS — оставьте этот блок.
  // 4. Просто оставьте этот блок, чтобы ни о чем не думать.
  "ntp": {
    "enabled": true,
    "interval": "30m0s",
    // https://kb.msk-ix.ru/public/ntp-server/
    "server": "ntp.msk-ix.ru",
    "server_port": 123,
    "detour": "🇷🇺 RU" // Следовать стратегии данного селектора
  },

  // ═══════════════════════════════════════════════
  // HTTP-клиенты (используются для загрузки наборов правил)
  // ═══════════════════════════════════════════════
  "http_clients": [
    // HTTP-клиент GLOBAL (прокси через селектор "🌍 Proxy")
    {
      "tag": "default",
      "version": 2,
      "detour": "GLOBAL",
      "stream_receive_window": 0,
      "connection_receive_window": 0
    }
  ],

  // ══════════════════════════════════════════════
  // Конфигурация Inbounds - входящие подключения,
  // определяющее режим работы SKeen (способ "попадания" данных в Sing-box.)
  // ══════════════════════════════════════════════
  "inbounds": [
    // Используем тип TProxy как самый оптимальный
     {
      "tag": "tproxy-in",
      "type": "tproxy",
      "listen": "::",
      "listen_port": 65082
    }
  ],

  // ══════════════════════════════════════════════
  // Конфигурация Outbounds - исходящие подключения
  // Как трафик "выходит": прямое соединение/прокси-узел
  // ══════════════════════════════════════════════
  "outbounds": [
    // Селекторы для переключения прокси в панели Zashboard
    { "tag": "🌍 Proxy",   "type": "selector", "outbounds": [ "🌍 Auto", "🔒 NAIVE" ], "default": "🔒 NAIVE" },
    { "tag": "🇷🇺 RU",      "type": "selector", "outbounds": [ "🇷🇺 Auto", "🔌 DIRECT", "🇷🇺 TROYAN" ] },
    { "tag": "🏴‍☠️ Torrent", "type": "selector", "outbounds": [ "🌍 Auto", "🔌 DIRECT", "🔒 NAIVE" ] },
    { "tag": "🕹️ Games",   "type": "selector", "outbounds": [ "🌍 Auto", "🔌 DIRECT", "🔒 NAIVE" ] },
    { "tag": "🤖 AI",      "type": "selector", "outbounds": [ "🌍 Auto", "🔌 DIRECT", "🔒 NAIVE" ] },
    { "tag": "🔌 DIRECT",  "type": "selector", "outbounds": [ "DIRECT" ] },
    // Прямое подключение к правайдеру (DIRECT)
    { "tag": "DIRECT", "type": "direct", "domain_resolver": "dns_direct" },
    // Глобальное подключение в качестве обходного маршрута для загрузки rule_set,
    // zashboard веб панели и обработки DNS-запросов проксируемого трафика.
    { "tag": "GLOBAL", "type": "selector", "outbounds": [ "🌍 Proxy" ] },

    // Список прокси-узлов
    {
      "tag": "🔒 NAIVE",
      "type": "naive",
      "server": "example.com",
      "server_port": 443,
      "username": "jinndi",
      "password": "password",
      "udp_over_tcp": true,
      "tls": { "enabled": true, "server_name": "example.com" }
    },
    {
      "tag": "🇷🇺 TROYAN",
      "type": "trojan",
      "password": "password",
      "server": "example.ru",
      "server_port": 2444,
      "tls": { "enabled": true, "server_name": "example.ru" },
      "multiplex": { "enabled": true }
    },

    // ...Примеры других (рабочих) типов узлов смотрите в фале client-outbounds.jsonc

    // Группы автоматического измерения задержки (доступности прокси-узлов)
    // Примечание: Проводят тест задержки на всех указанных в outbounds узлах каждые 10 минут и выбирайте тот, у которого наименьшая задержка.
    // tolerance=100: Можно выбрать любой узел с задержкой в ​​пределах 100 мс от максимальной задержки (балансировка нагрузки).
    { "tag": "🌍 Auto", "type": "urltest", "outbounds": [ "🔒 NAIVE" ], "interval": "10m", "tolerance": 100 },
    { "tag": "🇷🇺 Auto", "type": "urltest", "outbounds": [ "🇷🇺 TROYAN" ], "interval": "10m", "tolerance": 100 }
  ],

  // ══════════════════════════════════════════
  // Конфигурация маршрутизации — определяет,
  // использует ли каждое соединение прямое соединение или прокси-сервер.
  // ════════════════════════════════════════════
  "route": {
    "rules": [
      // Правило 1: Направять ICMP-пинги минуя прокси → Предотвращение утечек данных!
      // Правило необходимо если планируете использовать что-то кроме Redirect/TProxy/Hybrid
      { "network": "icmp", "outbound": "🔌 DIRECT" },

      // Правило 2: Сниффинг/Определение протокола
      // Извлечение доменного имени из поля SNI запроса TLS ClientHello
      // Извлечение доменного имени из заголовка Host HTTP-запроса
      // Результаты сниффинга используются для последующих правил определения доменных имен
      // action=sniff само по себе не определяет точку выхода, оно только извлекает доменное имя
      { "action": "sniff", "timeout": "500ms" },

      // Правило 3: Локальный REJECT для зарубежного QUIC (UDP/443).
      // Предотвращает таймауты браузера при блокировке DPI-системами.
      // ВАЖНО !!! Включайте это правило ТОЛЬКО если ваш провайдер агрессивно режет/замедляет UDP или если вы ловите таймауты на сайтах.
      // ВНИМАНИЕ: Может наглухо сломать некоторые мобильные приложения, которые жестко привязаны к экосистеме HTTP/3 и не умеют в полноценный TCP-fallback!
      // НЕ СТОИТ включать его «на всякий случай» только из-за страха, что sing-box некорректно определит домен (сниффинг).
      // Современное ядро sing-box отлично парсит QUIC-заголовки, поэтому ложной маршрутизации бояться не нужно.
      // { "action": "reject", "type": "logical", "mode": "and", "rules": [ { "protocol": "quic" }, { "rule_set": "ruip", "invert": true } ] },
      //-+-+-+--
      // Правило 3.1: Полный блок QUIC, если провайдер полносью заблочил/замедлил UDP/443,
      // либо вы параноик и любите ловить ошибки и подвисания в нестабильных интернетах.
      // Кому-то полный блок QUIC сэкономит 1% процессора на роутере, дерзайте.
      // { "action": "reject", "type": "logical", "mode": "and", "rules": [ { "protocol": "quic" }, { "port": 443 } ] },

      // Правило 4: Перехват DNS (порт 53 + протокол DNS)
      // Перехват обычных DNS-запросов к внутреннему DNS-модулю Sing-box → Предотвращение утечек данных!
      // Логическое ИЛИ: Порт 53 или протокол DNS; перехват происходит, если выполняется хотя бы одно из этих условий.
      { "action": "hijack-dns", "type": "logical", "mode": "or", "rules": [ { "protocol": "dns" }, { "port": 53 } ] },

      // Правило 5: Отклонить DoT(853) и mDNS(5353) → Предотвращает обход DNS-перехвата sing-box
      // DoT = DNS поверх TLS, зашифрованный DNS, обходящий перехват → Предотвращает возврат к порту 53
      // mDNS = Обнаружение устройств локальной сети осуществляется системой и не требует прокси-сервера.
      { "port": [ 853, 5353 ], "action": "reject" },

      // Правило 6: Отклонять недействительные публичные IPv6-адреса
      // Если маршрутизатор не назначил публичный IPv6-адрес (2000::/3), отклонять весь трафик IPv6
      // Предотвращает утечку прямых IPv6-соединений
      { "action": "reject", "type": "logical", "mode": "and", "rules": [ { "ip_version": 6 }, { "default_interface_address": "2000::/3", "invert": true } ] },

      // Правило 7: Отклоняем домены сервисов проверки гео-IP.
      // Полностью запрещает запросы к детекторам IP-адресов. Это немного гарантирует, что
      // ни ваш реальный IP-адрес, ни IP-адрес прокси-сервера не будут раскрыты
      // встроенными антифрод-системами внутри зловредных приложений.
      // ! 2ip.ru, 2ip.io и т.п. не откроются, это необходимая мера!
      { "rule_set": [ "ipdetect"], "action": "reject" },

      // Правило 8: Режим Clash "Direct"; да, так ему тут и надо.
      { "clash_mode": "Direct", "outbound": "🔌 Провайдер" },

      // Правило 9: Приватные домены через напрямую в DIRECT.
      { "rule_set": [ "private" ], "outbound": "🔌 DIRECT" },

      // Правило 10: Локальные сервисы чебурнета через провайдера.
      { "rule_set": [ "cheburnet"], "outbound": "🔌 DIRECT" },

      // Правило 11: Синхронизация времени NTP -> селектор "🇷🇺 RU"
      // Отправляем в селектор "🇷🇺 RU" чтобы гибко управлять трафиком NTP (NTP в KeeneticOS)
      { "protocol": [ "ntp" ], "outbound": "🇷🇺 RU" },

      // Правила 12: Назаначаем выходы (outbound) Нашим "Гибким" селекторам
      { "protocol": "bittorrent", "outbound": "🏴‍☠️ Torrent" },
      { "rule_set": [ "games" ], "outbound": "🕹️ Games" },
      { "rule_set": [ "ai" ], "outbound": "🤖 AI" },

      // Правило 13: Частные IP-адреса (192.168.xx и т. д.) → Прямой доступ
      { "ip_is_private": true, "outbound": "🔌 DIRECT" },

      // Правило 14: Принудительное использование прокси для диапазона фиктивных IP-адресов
      // Сопоставляет все соединения с целевыми IP-адресами в диапазоне 198.18.0.0/15 и fc00::/18.
      // Пояснение: Эти IP-адреса являются фиктивными и были ранее назначены DNS;
      // для соответствующих доменов было определено, что требуется прокси-сервер.
      // Следовательно, исходящий трафик должен принудительно проходить через прокси-сервер.
      // Это правило лежит в основе механизма FakeIP.
      { "ip_cidr": [ "198.18.0.0/15",  "fc00::/18" ], "outbound": "🌍 Proxy" },

      // Правило 15: Трафик для этих доменов проходит через прокси.
      // Примечание: Большинство этих доменов используют FakeIP на уровне DNS,
      // поэтому они фактически соответствуют сетевым сегментам FakeIP. (предыдущее правило)
      // Это указано еще раз в качестве резервного варианта для сценариев без FakeIP.
      { "rule_set": [ "proxy" ], "outbound": "🌍 Proxy" },

      // Правило 16: RU домены/IP (не в блоке т.к. после Fake-IP) -> селектор "🇷🇺 RU"
      // Пояснение: Эта часть трафика проходит напрямую через DIRECT либо прокси в РФ,
      // что обеспечивает скорость доступа внутри страны.
      { "rule_set": [ "ru", "ruip" ], "outbound": "🇷🇺 RU" },

      // Правило 17: Отклонить протокол STUN/DTLS
      // Протокол STUN используется в WebRTC для получения публичного IP-адреса, что может привести к его утечке.
      // DTLS - это зашифрованный UDP, широко используемый в WebRTC.
      // Пояснение: Эти пакеты отбрасываются напрямую, чтобы предотвратить утечку реального IP-адреса.
      // Краткое описание: Это важный способ защиты конфиденциальности.
      { "protocol": [ "stun", "dtls" ], "action": "reject", "method": "drop" },

      // Правило 18: Блокировка STUN/TURN и HTTPDNS
      //
      // РАСШИФРОВКА БЛОКИРУЕМЫХ ПОРТОВ (UDP):
      // - 3478 : Стандартный порт STUN. Главный источник утечек реального IP-адреса.
      // - 5349 : Зашифрованный STUN/TURN over TLS/DTLS. Используется для обхода DPI.
      // - 5350 : Резервный/альтернативный порт STUN (NAT-PMP / PCP).
      // - 19302: Фирменный порт Google STUN. Используется по умолчанию в 90% WebRTC-проектов.
      // - 10000: Дефолтный порт TURN-ретрансляторов (Coturn) и медиа-шлюзов.
      //
      // ЛОГИКА БЛОКИРОВКИ:
      // 1. STUN/TURN (WebRTC) блокируются, чтобы приложения не могли узнать реальный IP-адрес
      //    провайдера в обход прокси-туннеля (защита от WebRTC Leak).
      // 2. Ключевое слово 'httpdns' блокирует встроенные механизмы приложений,
      //    которые запрашивают IP серверов через HTTP-запросы напрямую у CDN, игнорируя системный DNS.
      {
        "type": "logical", "mode": "or",
        "rules": [
          { "network": "udp", "port": [ 3478, 5349, 5350, 19302, 10000 ] },
          { "domain_regex": "^stun\\..+" },
          { "domain_keyword": [ "stun", "turn", "httpdns" ] }
        ],
        "action": "reject", "method": "drop"
      },

      // Правило 19: Настройки параметров маршрутизации UDP
      // udp_disable_domain_unmapping: Отключает отмену сопоставления доменов UDP.
      // Пояснение: Пакеты UDP могут сопоставляться с доменными именами.
      // Отключение этого режима и использование IP-маршрутизации обеспечивает более стабильную работу.
      // udp_connect: true Включает режим UDP-соединения (аналогичный TCP),
      // который обеспечивает лучшую совместимость с такими протоколами, как QUIC.
      // Краткое описание: Эти два параметра оптимизируют работу UDP-прокси.
      { "action": "route-options", "udp_disable_domain_unmapping": true, "udp_connect": true },

      // Правило 20: Принудительное разрешение DNS
      // Для правил типа домена сначала необходимо получить разрешение на IP-адрес,
      // прежде чем они смогут соответствовать правилам IP.
      // Пояснение: Убедитесь, что весь трафик, требующий разрешения доменных имен, разрешен,
      // прежде чем переходить к следующему этапу сопоставления IP-адресов.
      { "action": "resolve" },

      // Правило 21: Глобальный Clash-режим через "🌍 Proxy" после всех правил,
      // для принудительного их использования в этом режиме
      { "clash_mode": "Global", "outbound": "🌍 Proxy" }
    ],

    // Наборы правил (11 шт)
    // Автоматическое обновление каждые 24 часа (по умолчанию) с помощью http_client
    // Использует http_client: по умолчанию = "🌍 Proxy" для загрузки
    // Дополнительные списки можно найти например здесь:
    // - https://github.com/senshinya/singbox_ruleset/tree/main/rule
    // - https://github.com/karingX/karing-ruleset
    "rule_set": [
      // jinndi (https://github.com/jinndi/singbox_ruleset)
      {
        "tag": [ "ipdetect", "private", "adguard", "cheburnet", "trackers", "filter", "games", "ai", "proxy", "ru", "ruip" ],
        "type": "remote", "url": "https://cdn.jsdelivr.net/gh/jinndi/singbox_ruleset@main/{tag}.srs"
      }
    ],

    // Глобальные настройки маршрутизатора
    "final": "🌍 Proxy",  // Крайний вариант: если ни одно правило не подходит → Используйте прокси из "🌍 Proxy"
                          // Окончательное правило: Весь несовпадающий трафик проходит через прокси
                          // Режим белого списка: Прямое соединение внутри РФ, все остальные — через прокси
                          // Это обеспечивает безопасность; неизвестные веб-сайты по умолчанию проходят через прокси
                          // Недостаток: Может по ошибке пройти через прокси некоторые нишевые РФ веб-сайты
                          // Именно поэтому приведенный выше набор правил должен быть максимально полным.
    "auto_detect_interface": true,   // Автоматическое определение сетевого интерфейса
    "default_domain_resolver": "dns_direct", // По умолчанию уровень маршрутизации использует DNS-серверы Yandex при разрешении доменных имен.
    "default_http_client": "global_client"  // http_client в качестве обходного маршрута для загрузки rule_set
  },

  // ═══════════════════════════════════════════
  // Конфигурация сервисов
  // Предоставляет Zashboard дополнительные API
  // ═══════════════════════════════════════════
  "services": [
    {
      "type": "api",
      "tag": "api",
      "listen": "::",
      "listen_port": 9998,
      "access_control_allow_private_network": true,
      "dashboard": false
    }
  ],

  // ═══════════════════════════════════════════
  // Экспериментальные функции
  // ═══════════════════════════════════════════
  "experimental": {
    // Файл кэша
    // Сохранение таблицы сопоставления fakeip и кэша DNS в cache.db
    // После перезапуска sing-box восстанавливается мгновенно.
    "cache_file": {
      "enabled": true,      // Включить кэширование
      "path": "cache.db",   // Путь к файлу кэша
      "cache_id": "v1_14",  // Идентификатор кэша (используется для разделения разных кэшей при переключении конфигураций)
      "store_fakeip": true, // Сохраняет сопоставления FakeIP в файле кэша
                            // Пояснение: Включение этой функции улучшает работу после перезагрузки и обеспечивает бесперебойное соединение.
      "store_dns": true     // Сохранить в кэш разрешенные DNS-запросы
    },

    // API Clash
    // Предоставляет REST API, совместимый с Clash, которым можно управлять через такие панели, как Yacd, Zashboard и т.д.
    "clash_api": {
      "external_controller": "0.0.0.0:9999", // Адрес прослушивания API
      "external_ui": "zashboard",            // Каталог файлов веб-панели
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist-no-fonts.zip", // URL адрес Zashboard .zip панели
      "external_ui_download_detour": "GLOBAL", // Скачивание файлов панели через глобальный селектор
      "default_mode": "Rule"   // Режим правил по умолчанию
    },

    // Конфигурация отладки/производительности
    "debug": {
      "gc_percent": 100, // Порог срабатывания сборки мусора по умолчанию
      // Частота запуска сборки мусора Go: 100% (сборка мусора запускается, когда объем памяти увеличивается вдвое по сравнению с первоначальным размером).
      // Более низкие значения = более частая сборка мусора = меньшее использование памяти, но большее потребление ЦП.
      // 100 — значение по умолчанию в Go, обеспечивающее баланс между памятью и ЦП.
      "memory_limit": "200MB" // Ограничение по памяти: 200 МБ (превышение этого лимита приведет к принудительной сборке мусора)
      // Когда памяти роутера мало, это значение можно уменьшить, например, до "50MB"
    }
  }
}
