// Примеры конфигурации конечных точек на стороне клиента sing-box
// На стороне сервера смотрите в файле examples/v1.14/Server-sing-box.md

{
  "endpoints": [
    // 1. Tailscale на роутере в качестве клиента с выходом на серверную точку (server-ep)
    // Для управления и просмотра информации используйте панель Zashboard через api sing-box
    {
      "type": "tailscale",
      "tag": "ts-router-ep",
      "auth_key": "tskey-auth-...",  // Ключ авторизации (подробнее в examples/v1.14/Server-sing-box.md)
      "state_directory": "tailscale",
      "hostname": "router-ep",  // Задать имя хосту
      "exit_node": "server-ep", // Имя или IP-адрес выходного узла для использования.
      "accept_routes": true,    // Указывает, должен ли узел принимать маршруты, объявленные другими узлами.
      "taildrop_directory": "files", // Папка для хранения файлов Taildrop (можно указать полный путь)
      "detour": "😎 Trojan" // Если доступа к панели управления Tailscale нет укажите тут тег прокси узла для подключения
                            // ВНИМАНИЕ: Влияет только на способ подключения к плоскости управления
                            // и не имеют никакого отношения к фактическим соединениям.
    }
  ]
}
